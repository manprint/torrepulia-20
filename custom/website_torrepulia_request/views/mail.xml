<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Email body of the request notifications. Email clients ignore
         stylesheets and web fonts: tables, inline styles and the theme colors
         ink, muted, line, olive and gold-text of design_system.scss. -->
    <template id="mail_request_body" name="Torrepulia: email della richiesta">
        <t t-set="serif" t-value="&quot;font-family:'Libre Caslon Display',Georgia,'Times New Roman',serif;font-weight:400;color:#18231f;&quot;"/>
        <t t-set="sans" t-value="&quot;font-family:Manrope,-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;&quot;"/>
        <t t-set="customer" t-value="kind == 'customer'"/>
        <div t-attf-style="margin:0;padding:24px 12px;background-color:#f6f6f4;#{sans}">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                   style="max-width:600px;margin:0 auto;background-color:#ffffff;border:1px solid #d2dcd4;border-collapse:separate;">
                <tr><td align="center" style="padding:32px 40px 8px;">
                    <a t-att-href="base_url" style="text-decoration:none;">
                        <img t-att-src="logo_url" t-att-alt="company['name']" width="120" style="display:block;width:120px;height:auto;border:0;"/>
                    </a>
                </td></tr>
                <tr><td style="padding:24px 40px 0;">
                    <h1 t-attf-style="margin:0 0 12px;font-size:30px;line-height:1.2;#{serif}">
                        <t t-if="customer and reservation">Grazie, <t t-out="first_name"/>. La tua prenotazione è registrata.</t>
                        <t t-elif="customer">Abbiamo ricevuto la tua richiesta</t>
                        <t t-elif="reservation">Nuova prenotazione dell’olio nuovo</t>
                        <t t-else="">Richiesta sito web ricevuta</t>
                    </h1>
                    <p style="margin:0;font-size:16px;line-height:1.6;color:#526056;">
                        <t t-if="customer and reservation">Ecco il riepilogo dell’olio nuovo del raccolto <t t-out="reservation['season']"/> che hai scelto.</t>
                        <t t-elif="not customer">Da <t t-out="record.contact_name"/>.</t>
                        Riferimento <strong style="color:#18231f;" t-out="record.name"/>.
                    </p>
                </td></tr>

                <tr t-if="reservation and reservation.get('facts')"><td style="padding:28px 40px 0;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">
                        <tr t-foreach="reservation['facts']" t-as="fact">
                            <td width="92" valign="top" style="padding:12px 12px 12px 0;border-top:1px solid #d2dcd4;font-size:13px;line-height:1.5;color:#746014;" t-out="fact[0]"/>
                            <td valign="top" t-attf-style="padding:10px 0 12px;border-top:1px solid #d2dcd4;font-size:17px;line-height:1.4;#{serif}" t-out="fact[1]"/>
                        </tr>
                        <tr><td colspan="2" style="border-top:1px solid #d2dcd4;font-size:0;line-height:0;">&#160;</td></tr>
                    </table>
                </td></tr>

                <tr><td style="padding:32px 40px 0;">
                    <h2 t-attf-style="margin:0 0 8px;font-size:22px;line-height:1.3;#{serif}">
                        <t t-if="customer and reservation">Il tuo olio</t><t t-elif="reservation">Olio prenotato</t><t t-else="">I prodotti</t>
                    </h2>
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">
                        <tr t-foreach="rows" t-as="row">
                            <td width="68" valign="top" style="padding:16px 12px 16px 0;border-bottom:1px solid #d2dcd4;">
                                <img t-if="row['thumbnail']" t-att-src="row['thumbnail']" alt="" width="56" height="56"
                                     style="display:block;width:56px;height:56px;border:0;background-color:#f6f6f4;object-fit:contain;"/>
                            </td>
                            <td valign="top" style="padding:16px 0;border-bottom:1px solid #d2dcd4;font-size:15px;line-height:1.5;">
                                <strong style="color:#18231f;font-weight:600;" t-out="row['name']"/><br/>
                                <span t-if="row['details']" style="color:#526056;"><t t-out="row['details']"/><br/></span>
                                <span style="color:#526056;">Quantità <t t-out="row['quantity']"/></span>
                            </td>
                            <td valign="top" align="right" style="padding:16px 0 16px 16px;border-bottom:1px solid #d2dcd4;font-size:15px;line-height:1.5;color:#18231f;white-space:nowrap;"
                                t-out="row['subtotal'] or ''"/>
                        </tr>
                        <tr t-if="total">
                            <td colspan="2" style="padding:16px 0 0;font-size:15px;line-height:1.5;color:#18231f;">
                                <t t-if="reservation">Totale prodotti</t><t t-else="">Totale prodotti della richiesta</t>
                            </td>
                            <td align="right" style="padding:16px 0 0 16px;font-size:17px;line-height:1.5;color:#18231f;font-weight:600;white-space:nowrap;" t-out="total"/>
                        </tr>
                        <tr t-if="total"><td colspan="3" style="padding:4px 0 0;font-size:13px;line-height:1.5;color:#526056;">
                            <t t-if="reservation" t-out="reservation.get('shipping_note') or 'Spese di spedizione indicate nella conferma d’ordine.'"/>
                            <t t-else="">Spese di consegna da definire.</t>
                        </td></tr>
                    </table>
                </td></tr>

                <tr t-if="customer and reservation"><td style="padding:36px 40px 0;">
                    <h2 t-attf-style="margin:0 0 4px;font-size:22px;line-height:1.3;#{serif}">Cosa succede adesso</h2>
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">
                        <t t-foreach="[('Ti mandiamo la conferma d’ordine', 'Qualche giorno prima della molitura, con il prezzo di oggi, le spese di spedizione e il totale.'),
                                       ('Confermi l’ordine', 'Hai %s giorni per confermarlo e completare il pagamento: trovi tutte le indicazioni nella conferma.' % reservation.get('confirmation_days', 7)),
                                       ('Lo ricevi a casa', 'Ricevuto il pagamento, ti spediamo l’olio nuovo direttamente da Torremaggiore.')]" t-as="step">
                            <tr>
                                <td width="36" valign="top" style="padding:14px 0 0;font-family:'Libre Caslon Display',Georgia,'Times New Roman',serif;font-size:24px;line-height:1.2;color:#746014;" t-out="step_index + 1"/>
                                <td valign="top" style="padding:14px 0 0;font-size:15px;line-height:1.5;">
                                    <strong style="color:#18231f;font-weight:600;" t-out="step[0]"/><br/>
                                    <span style="color:#526056;" t-out="step[1]"/>
                                </td>
                            </tr>
                        </t>
                    </table>
                </td></tr>

                <tr t-if="customer"><td style="padding:32px 40px 0;">
                    <p t-if="not reservation" style="margin:0 0 12px;font-size:15px;line-height:1.6;color:#526056;">
                        La richiesta non conferma un ordine e non richiede un pagamento. Ti contatteremo per definire disponibilità, consegna e condizioni.
                    </p>
                    <p style="margin:0;padding:20px 24px;background-color:#eef2ed;font-size:15px;line-height:1.6;color:#18231f;">
                        <t t-if="reservation">Fino alla conferma d’ordine puoi cambiare formati e quantità, o annullare la prenotazione senza costi:</t><t t-else="">Hai una domanda?</t>
                        <t t-if="reservation">rispondi</t><t t-else="">Rispondi</t> a questa email<t t-if="company['phone']"> o chiamaci al
                        <a t-attf-href="tel:#{company['phone'].replace(' ', '')}" style="color:#2e493b;font-weight:600;text-decoration:underline;" t-out="company['phone']"/></t>.
                    </p>
                </td></tr>

                <tr t-if="not customer"><td style="padding:32px 40px 0;font-size:15px;line-height:1.6;color:#18231f;">
                    <h2 t-attf-style="margin:0 0 8px;font-size:22px;line-height:1.3;#{serif}">Contatto</h2>
                    <t t-out="record.contact_name"/><br/>
                    <a t-attf-href="mailto:#{record.email}" style="color:#2e493b;" t-out="record.email"/><br/>
                    <t t-if="record.phone"><t t-out="record.phone"/><br/></t>
                    <p t-if="record.notes" style="margin:12px 0 0;white-space:pre-wrap;color:#526056;" t-out="record.notes"/>
                    <p t-if="reservation" style="margin:16px 0 0;color:#526056;">
                        Nessun anticipo incassato. Prima della molitura invia la conferma d’ordine dall’opportunità:
                        il cliente ha <t t-out="reservation.get('confirmation_days', 7)"/> giorni per confermarla e pagarla, poi si spedisce.
                    </p>
                    <p t-else="" style="margin:16px 0 0;color:#526056;">
                        La richiesta non conferma un ordine e non richiede un pagamento.
                        Aprire l’opportunità CRM per consultare le righe e qualificare la richiesta.
                    </p>
                    <p t-if="lead_url" style="margin:20px 0 0;">
                        <a t-att-href="lead_url" style="display:inline-block;padding:12px 24px;background-color:#2e493b;color:#ffffff;font-weight:600;text-decoration:none;border-radius:3px;">Apri l’opportunità</a>
                    </p>
                </td></tr>

                <tr><td style="padding:40px 40px 32px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">
                        <tr><td style="padding-top:20px;border-top:1px solid #d2dcd4;font-size:13px;line-height:1.6;color:#526056;">
                            <t t-if="customer">Famiglia Leone, Torremaggiore<br/></t>
                            <t t-out="company['name']"/><t t-if="company['address']"> · <t t-out="company['address']"/></t><br/>
                            <t t-if="company['vat']">P. IVA <t t-out="company['vat']"/> · </t>
                            <a t-att-href="base_url" style="color:#526056;" t-out="base_url.split('://')[-1]"/>
                        </td></tr>
                    </table>
                </td></tr>
            </table>
        </div>
    </template>
</odoo>
