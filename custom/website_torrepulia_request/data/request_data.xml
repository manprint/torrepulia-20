<odoo noupdate="1">
    <record id="sequence_request" model="ir.sequence">
        <field name="name">Torrepulia quote request</field>
        <field name="code">torrepulia.request</field>
        <field name="prefix">TPR/</field>
        <field name="padding">8</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="cron_expire_request_drafts" model="ir.cron">
        <field name="name">Torrepulia: elimina bozze richiesta scadute</field>
        <field name="model_id" ref="model_torrepulia_request"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire_drafts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
