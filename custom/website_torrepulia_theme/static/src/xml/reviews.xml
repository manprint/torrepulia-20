<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Product reviews (portal chatter of portal_rating). Odoo 20 ships these texts without an
         Italian translation; with no review yet the "0" and the empty bars read as "nobody buys it":
         an invitation to write the first one takes their place. -->
    <t t-inherit="portal.Chatter" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Chatter-top')]/div[@t-if='this.displayRating']" position="attributes">
            <attribute name="t-if">this.displayRating and this.ratingStats?.total</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o-mail-Chatter-top')]/div[@t-if='this.reviewChatter']" position="before">
            <div t-if="this.displayRating and this.state.thread?.isLoaded and !this.ratingStats?.total" class="tp-reviews-empty">
                <p class="tp-reviews-empty-title">Ancora nessuna recensione</p>
                <p>Lo hai già provato? Raccontaci com&#8217;è: la tua recensione aiuta chi lo sceglie per la prima volta.</p>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('o-mail-Chatter-content')]/p[hasclass('fs-4')]" position="replace"/>
    </t>

    <t t-inherit="portal_rating.rating_card" t-inherit-mode="extension">
        <xpath expr="//span[hasclass('text-muted')]" position="replace">
            <span class="text-muted">
                <t t-out="total_rating_stats"/>
                <t t-if="total_rating_stats == 1"> recensione</t>
                <t t-else=""> recensioni</t>
            </span>
        </xpath>
    </t>

    <t t-inherit="portal_rating.actions" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('alert')]" position="replace">
            <a t-elif="this.env.inFrontendPortalChatter" class="btn btn-primary" t-att-href="this.loginRedirectUrl">Accedi per scrivere una recensione</a>
        </xpath>
    </t>
</templates>
