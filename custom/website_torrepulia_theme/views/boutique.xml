<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- One product page for La Regina: the format is chosen here, each option opens its own native product. -->
    <template id="pdp_formats" name="La Regina format choice">
        <t t-set="tp_formats" t-value="website._cinematic_products()"/>
        <div t-if="product in tp_formats and len(tp_formats) &gt; 1" class="o_wsale_product_details_content_section tp-formats" role="group" aria-labelledby="tp-formats-label">
            <p id="tp-formats-label" class="tp-option-label">Formato</p>
            <div class="tp-format-list">
                <a t-foreach="tp_formats" t-as="fmt" t-att-href="fmt.website_url"
                   t-attf-class="tp-format #{'is-current' if fmt == product else ''}"
                   t-att-aria-current="'page' if fmt == product else None">
                    <t t-set="fmt_info" t-value="fmt._get_combination_info(product_id=fmt.product_variant_id.id)"/>
                    <span class="tp-format-dot" aria-hidden="true"/>
                    <span class="tp-format-name">
                        <strong t-out="fmt.torrepulia_format_name or fmt.name"/>
                        <small t-if="fmt.torrepulia_format_detail" t-out="fmt.torrepulia_format_detail"/>
                    </span>
                    <span class="tp-format-price">
                        <t t-if="not fmt_info.get('hide_price')">
                            <span t-out="fmt_info['price']" t-options="{'widget': 'monetary', 'display_currency': fmt_info['currency']}"/>
                            <small t-if="fmt_info.get('base_unit_price')">
                                <span t-out="fmt_info['base_unit_price']" t-options="{'widget': 'monetary', 'display_currency': fmt_info['currency']}"/> / <t t-out="fmt_info.get('base_unit_name')"/>
                            </small>
                        </t>
                        <small t-if="website._torrepulia_format_preorder(fmt)" class="tp-format-state">In prenotazione</small>
                    </span>
                </a>
            </div>
        </div>
    </template>

    <template id="pdp_assurances" name="Product page assurances">
        <ul class="tp-assure">
            <li>Spedito da Torremaggiore, imballo protetto per vetro e latta</li>
            <li t-if="website.torrepulia_shipping_note" t-out="website.torrepulia_shipping_note"/>
            <t t-set="tp_phone" t-value="website.company_id.phone or '+39 380 637 5074'"/>
            <li>Domande sul formato giusto? <a t-att-href="'tel:%s' % tp_phone.replace(' ', '')" t-out="tp_phone"/></li>
        </ul>
    </template>

    <template id="pdp_oil_profile" name="Oil identity card">
        <section class="tp-idcard" aria-labelledby="tp-idcard-title">
            <div class="tp-idcard-intro">
                <h2 id="tp-idcard-title">Carta d'identità dell'olio</h2>
                <p class="tp-idcard-source" t-out="profile._torrepulia_source()"/>
                <a t-if="profile.report_url" class="tp-idcard-report" t-att-href="profile.report_url" target="_blank" rel="noopener">Leggi il rapporto di prova (PDF)</a>
                <dl t-if="profile._torrepulia_facts()" class="tp-idcard-facts">
                    <div t-foreach="profile._torrepulia_facts()" t-as="fact"><dt t-out="fact[0]"/><dd t-out="fact[1]"/></div>
                </dl>
            </div>
            <div t-if="profile._torrepulia_lab_rows()" class="tp-lab-wrap">
                <table class="tp-lab">
                    <caption class="visually-hidden">Analisi di laboratorio confrontata con i limiti di legge per l'olio extravergine</caption>
                    <thead><tr><th scope="col">Parametro</th><th scope="col">Valore</th><th scope="col">Limite extravergine</th><th scope="col" class="tp-lab-scale-head">Quota del limite</th></tr></thead>
                    <tbody>
                        <tr t-foreach="profile._torrepulia_lab_rows()" t-as="row">
                            <th scope="row" t-out="row['label']"/>
                            <td class="tp-lab-value" t-out="row['value']"/>
                            <td class="tp-lab-limit" t-out="row['limit']"/>
                            <td>
                                <span t-if="row['ratio'] is not None" class="tp-lab-scale" role="img"
                                      t-att-aria-label="'%s per cento del limite' % row['ratio']">
                                    <span t-attf-style="width: #{row['ratio']}%"/>
                                </span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
    </template>

    <!-- Shop: the new oil opens the page in season, then one format per row. -->
    <template id="shop_season" name="New oil season band">
        <t t-set="tp_season" t-value="website._torrepulia_preorder_season()"/>
        <section t-if="tp_season" class="tp-season" aria-labelledby="tp-season-title">
            <img class="tp-season-photo" src="/website_torrepulia_theme/static/src/cinematic/campaign/land-640.webp"
                 srcset="/website_torrepulia_theme/static/src/cinematic/campaign/land-640.webp 640w, /website_torrepulia_theme/static/src/cinematic/campaign/land-1280.webp 1280w"
                 sizes="(max-width: 760px) 100vw, 260px" alt="Gli uliveti di Torremaggiore" width="640" height="360"/>
            <div class="tp-season-copy">
                <h2 id="tp-season-title" t-out="tp_season['title']"/>
                <p t-if="tp_season['text']" t-out="tp_season['text']"/>
            </div>
            <a class="btn tp-season-action" t-att-href="tp_season['url']">Prenota</a>
        </section>
    </template>

    <!-- Shared by the shop rows and the home formats: tp_preorder, tp_sold_out and tp_season in scope. -->
    <template id="format_state" name="Format state label">
        <span t-if="tp_preorder" class="tp-shop-state is-preorder" t-out="tp_season['label'] if tp_season else 'In prenotazione'"/>
        <span t-elif="tp_sold_out" class="tp-shop-state is-sold-out" t-out="website.torrepulia_shop_sold_out_label or 'Temporaneamente esaurito'"/>
        <span t-else="" class="tp-shop-state is-available" t-out="website.torrepulia_shop_available_label or 'Disponibile subito'"/>
    </template>

    <template id="shop_rows" name="Shop formats, one per row">
        <t t-set="tp_season" t-value="website._torrepulia_preorder_season()"/>
        <ul class="tp-shop-rows" aria-label="Formati">
            <li t-foreach="products" t-as="p" class="tp-shop-row">
                <t t-set="tp_info" t-value="p._get_combination_info(product_id=p.product_variant_id.id)"/>
                <t t-set="tp_preorder" t-value="website._torrepulia_format_preorder(p)"/>
                <t t-set="tp_sold_out" t-value="not tp_preorder and p._is_sold_out()"/>
                <a class="tp-shop-row-photo" t-att-href="p.website_url" tabindex="-1" aria-hidden="true">
                    <t t-call="website_torrepulia_theme.cinematic_pack"/>
                </a>
                <div class="tp-shop-row-copy">
                    <t t-call="website_torrepulia_theme.format_state"/>
                    <h2><a t-att-href="p.website_url" t-out="p.torrepulia_format_name or p.name"/></h2>
                    <p t-if="p.torrepulia_shop_audience" class="tp-shop-audience" t-out="p.torrepulia_shop_audience"/>
                    <p t-if="not tp_info.get('hide_price') and tp_info.get('base_unit_price')" class="tp-shop-unit-price">
                        <span t-out="tp_info['base_unit_price']" t-options="{'widget': 'monetary', 'display_currency': tp_info['currency']}"/> / <t t-out="tp_info.get('base_unit_name')"/>
                    </p>
                </div>
                <div class="tp-shop-row-action">
                    <span t-if="not tp_info.get('hide_price')" class="tp-shop-price" t-out="tp_info['price']" t-options="{'widget': 'monetary', 'display_currency': tp_info['currency']}"/>
                    <a t-if="tp_preorder" class="btn btn-primary" t-att-href="tp_preorder">Prenota</a>
                    <a t-elif="tp_sold_out and tp_season" class="btn btn-outline-primary" t-att-href="tp_season['url']">Prenota il nuovo raccolto</a>
                    <a t-elif="tp_sold_out" class="btn btn-outline-primary" t-att-href="p.website_url">Dettagli</a>
                    <a t-else="" class="btn btn-primary" t-att-href="p.website_url">Acquista</a>
                </div>
            </li>
        </ul>
    </template>

    <template id="shop_boutique" inherit_id="website_sale.products" name="Torrepulia boutique shop">
        <!-- Three formats need no search, sorting or wishlist. -->
        <xpath expr="//div[hasclass('products_header')]" position="attributes">
            <attribute name="t-if">not opt_wsale_floating_bar and not website._torrepulia_shop_rows_enabled()</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_wsale_products_grid_table_wrapper')]" position="before">
            <t t-if="website.torrepulia_theme_enabled and not search and not category" t-call="website_torrepulia_theme.shop_season"/>
        </xpath>
        <xpath expr="//section[@id='o_wsale_products_grid']" position="attributes">
            <attribute name="t-if">not website._torrepulia_shop_rows_enabled()</attribute>
        </xpath>
        <xpath expr="//section[@id='o_wsale_products_grid']" position="before">
            <t t-if="website._torrepulia_shop_rows_enabled()" t-call="website_torrepulia_theme.shop_rows"/>
        </xpath>
    </template>

    <template id="base_unit_name_variant" inherit_id="website_sale.base_unit_price" name="Variant base unit name">
        <!-- With several variants the template has no base unit: name the one of the shown combination. -->
        <xpath expr="//span[hasclass('oe_custom_base_unit')]" position="attributes">
            <attribute name="t-field"/>
            <attribute name="t-out">combination_info and combination_info.get('base_unit_name') or product.base_unit_name</attribute>
        </xpath>
    </template>

    <template id="pdp_boutique" inherit_id="website_sale.product" name="Torrepulia boutique product page">
        <xpath expr="//t[@t-call='website_sale.container_dropzone_above_price']" position="before">
            <t t-if="website.torrepulia_theme_enabled" t-call="website_torrepulia_theme.pdp_formats"/>
        </xpath>
        <xpath expr="//div[@id='o_wsale_product_cta_section']" position="after">
            <t t-if="website.torrepulia_theme_enabled" t-call="website_torrepulia_theme.pdp_assurances"/>
        </xpath>
        <xpath expr="//div[@id='product_full_description']" position="before">
            <div t-if="website.torrepulia_theme_enabled and product._torrepulia_oil_profile()" class="container tp-idcard-container">
                <t t-call="website_torrepulia_theme.pdp_oil_profile" profile="product._torrepulia_oil_profile()"/>
            </div>
        </xpath>
    </template>
</odoo>
