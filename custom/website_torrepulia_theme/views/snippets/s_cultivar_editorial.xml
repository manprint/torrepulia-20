<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_torrepulia_cultivar_opening" name="Torrepulia La Cultivar Reale">
        <section class="s_torrepulia_snippet tp-cultivar-intro tp-oil-opening o_colored_level" data-snippet="s_torrepulia_cultivar_opening" data-name="La Cultivar Reale">
            <div class="container py-5">
                <div class="row gy-5 gx-4 gx-xl-5 align-items-center">
                    <div class="col-12 col-lg-7 o_colored_level">
                        <h1 class="display-5 fw-bold mb-4">La Peranzana.<br/>Il nostro punto <span class="text-nowrap">di origine.</span></h1>
                        <p class="lead text-dark mb-4">La <strong>Peranzana</strong> &#232; la cultivar dell&#8217;Alto Tavoliere delle Puglie. &#200; a duplice attitudine: apprezzata sia per l&#8217;olio che se ne ricava sia da gustare come oliva da tavola. La coltiviamo nell&#8217;agro di <strong>Torremaggiore</strong> da tre generazioni: qui il vento, la terra fertile del Tavoliere e il sole della Puglia le danno il suo carattere distintivo. Dalle sue olive nasce <strong>La Regina</strong>, il nostro olio extravergine.</p>
                        <div class="tp-oil-links">
                            <a class="tp-oil-process-link text-decoration-none fw-bold d-inline-flex align-items-center gap-2" href="#processo">Come nasce La Regina <img class="icon" src="/website_torrepulia_theme/static/src/cinematic/icons/arrow-right.svg" alt="" width="20" height="20"/></a>
                            <a class="tp-oil-process-link text-decoration-none fw-bold d-inline-flex align-items-center gap-2" href="#analisi">Le analisi del raccolto <img class="icon" src="/website_torrepulia_theme/static/src/cinematic/icons/arrow-right.svg" alt="" width="20" height="20"/></a>
                        </div>
                    </div>
                    <div class="col-12 col-lg-5 o_colored_level">
                        <img class="img img-fluid w-100 rounded-3 tp-oil-photo" src="/website_torrepulia_theme/static/src/cinematic/campaign/olive-1280.webp" srcset="/website_torrepulia_theme/static/src/cinematic/campaign/olive-640.webp 640w, /website_torrepulia_theme/static/src/cinematic/campaign/olive-1280.webp 1280w, /website_torrepulia_theme/static/src/cinematic/campaign/olive-1600.webp 1600w" sizes="(min-width: 992px) 42vw, 100vw" width="1280" height="853" alt="Olive Peranzana sul ramo, tra gli ulivi di Torrepulia" loading="eager" fetchpriority="high"/>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <template id="s_torrepulia_cultivar_history" name="Torrepulia Origini della Peranzana">
        <section class="s_torrepulia_snippet tp-oil-history o_colored_level" data-snippet="s_torrepulia_cultivar_history" data-name="Origini della Peranzana">
            <div class="container py-5">
                <div class="row gy-4 gx-5 tp-oil-history-story">
                    <div class="col-12 col-lg-5 o_colored_level">
                        <h2 class="fw-bold mb-4">Un nome che viene da lontano, un&#8217;anima pugliese.</h2>
                    </div>
                    <div class="col-12 col-lg-7 o_colored_level">
                        <p class="fs-5 text-dark mb-4">La tradizione lega l&#8217;arrivo della <strong>Peranzana</strong> nell&#8217;Alto Tavoliere al principe Raimondo di Sangro, che l&#8217;avrebbe portata dalla Provenza nelle terre della sua famiglia. Il nome conserva quel viaggio: da &#8220;Provenzale&#8221;, nella parlata locale, sarebbe nata la parola &#8220;Peranzana&#8221;.</p>
                    </div>
                </div>
                <!-- The map is the home's map, inlined: a t-call here would lock the Builder out of the section. -->
                <div class="tp-oil-territory row gy-4 gx-5 align-items-center o_colored_level">
                    <div class="col-12 col-lg-6 o_colored_level">
                        <figure class="tp-oil-map">
                            <t t-call="website_torrepulia_theme.s_puglia_map"/>
                        </figure>
                    </div>
                    <div class="col-12 col-lg-6 o_colored_level">
                        <h3 class="mb-4">Il cuore della Peranzana.</h3>
                        <p>Tra <strong>Torremaggiore, San Severo e San Paolo di Civitate</strong> si concentra la coltivazione della Peranzana. I nostri uliveti si trovano nell&#8217;agro di Torremaggiore e contano oltre 1.500 piante: dalle loro olive nasce La Regina, il nostro olio extravergine.</p>
                        <a class="tp-oil-process-link text-decoration-none fw-bold d-inline-flex align-items-center gap-2" href="/territorio">Il territorio <img class="icon tp-icon-out" src="/website_torrepulia_theme/static/src/cinematic/icons/arrow-up-right.svg" alt="" width="20" height="20"/></a>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
