<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_torrepulia_hero" name="Torrepulia Hero">
        <section class="s_torrepulia_snippet tp-hero" data-snippet="s_torrepulia_hero" data-name="Torrepulia Hero">
            <div class="container-fluid p-0">
                <div class="row g-0 min-vh-75">
                    <div class="col-lg-5 tp-hero__copy">
                        <p class="tp-eyebrow mb-4">Torremaggiore, Alto Tavoliere</p>
                        <h1>Il carattere autentico della Peranzana.</h1>
                        <p class="mt-4 mb-5">Olio extravergine di oliva La Regina, ottenuto unicamente da olive di varietà Peranzana coltivate nell'agro di Torremaggiore.</p>
                        <div class="d-flex flex-wrap gap-3">
                            <a class="btn btn-primary btn-lg" href="/shop">Scopri il nostro olio</a>
                            <a class="btn btn-outline-light btn-lg" href="/aboutus">La nostra storia</a>
                        </div>
                    </div>
                    <div class="col-lg-7 tp-hero__media">
                        <img src="/website_torrepulia_theme/static/src/img/content/olive-grove-editorial.jpg" alt="Uliveto Torrepulia di Peranzana" loading="eager"/>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
