<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_torrepulia_production_process" name="Torrepulia Production Process">
        <section id="processo" class="s_torrepulia_snippet tp-section tp-process o_colored_level" data-snippet="s_torrepulia_production_process" data-name="Raccogliamo, moliamo, spediamo">
            <div class="container">
                <div class="row gy-5 gx-5">
                    <div class="col-12 col-lg-5 o_colored_level">
                        <div class="tp-process-intro">
                            <h2>Raccogliamo, moliamo, spediamo.</h2>
                            <p>Ogni passaggio, dalla pianta alla spedizione, lo seguiamo di persona. Tra il nostro uliveto e la tua tavola non ci sono intermediari.</p>
                            <!-- Placeholder for a real family quote: hidden from visitors, listed in the Builder's invisible elements. -->
                            <blockquote class="tp-placeholder o_snippet_desktop_invisible o_snippet_mobile_invisible d-none">
                                <p>[SEGNAPOSTO, NON PUBBLICATO] Qui una frase vera di pap&#224; Michele o di nonno Santino Vincenzo sulla raccolta.</p>
                                <footer>[Chi l&#8217;ha detta]</footer>
                            </blockquote>
                            <img class="img img-fluid tp-process-photo" src="/website_torrepulia_theme/static/src/cinematic/owner/raccolta-reti-1280.webp" srcset="/website_torrepulia_theme/static/src/cinematic/owner/raccolta-reti-640.webp 640w, /website_torrepulia_theme/static/src/cinematic/owner/raccolta-reti-1280.webp 1280w, /website_torrepulia_theme/static/src/cinematic/owner/raccolta-reti-1920.webp 1920w" sizes="(min-width: 1200px) 520px, (min-width: 992px) 40vw, 100vw" alt="Un collaboratore trascina il telo della raccolta sotto gli ulivi" width="1280" height="853" loading="lazy"/>
                        </div>
                    </div>
                    <div class="col-12 col-lg-7 o_colored_level">
                        <ol class="tp-process-steps">
                            <li class="tp-process-step">
                                <img class="img img-fluid" src="/website_torrepulia_theme/static/src/cinematic/owner/process-harvest.webp" srcset="/website_torrepulia_theme/static/src/cinematic/owner/process-harvest-480.webp 480w, /website_torrepulia_theme/static/src/cinematic/owner/process-harvest.webp 960w" sizes="(min-width: 992px) 240px, 128px" alt="Ramo carico di olive Peranzana; sullo sfondo un collaboratore scuote la pianta sopra i teli" width="960" height="960" loading="lazy"/>
                                <div>
                                    <h3>La raccolta</h3>
                                    <p>Tra ottobre e novembre, all&#8217;inizio dell&#8217;invaiatura, cogliamo le olive dalla pianta.</p>
                                </div>
                            </li>
                            <li class="tp-process-step">
                                <img class="img img-fluid" src="/website_torrepulia_theme/static/src/cinematic/owner/process-crates.webp" srcset="/website_torrepulia_theme/static/src/cinematic/owner/process-crates-480.webp 480w, /website_torrepulia_theme/static/src/cinematic/owner/process-crates.webp 960w" sizes="(min-width: 992px) 240px, 128px" alt="Olive appena raccolte nei contenitori forati, tra gli ulivi" width="960" height="960" loading="lazy"/>
                                <div>
                                    <h3>Le cassette forate</h3>
                                    <p>Le olive vanno subito in contenitori forati: l&#8217;aria passa, il frutto non si schiaccia e non fermenta.</p>
                                </div>
                            </li>
                            <li class="tp-process-step">
                                <img class="img img-fluid" src="/website_torrepulia_theme/static/src/cinematic/owner/process-mill.webp" srcset="/website_torrepulia_theme/static/src/cinematic/owner/process-mill-480.webp 480w, /website_torrepulia_theme/static/src/cinematic/owner/process-mill.webp 950w" sizes="(min-width: 992px) 240px, 128px" alt="Olio appena estratto all'uscita dell'impianto in frantoio" width="950" height="960" loading="lazy"/>
                                <div>
                                    <h3>La molitura</h3>
                                    <p>Entro 8 ore dalla raccolta moliamo le olive nel nostro frantoio partner, con estrazione a freddo sotto i 27 &#176;C. Seguiamo la molitura di persona.</p>
                                </div>
                            </li>
                            <li class="tp-process-step">
                                <img class="img img-fluid" src="/website_torrepulia_theme/static/src/cinematic/owner/process-bottling.webp" srcset="/website_torrepulia_theme/static/src/cinematic/owner/process-bottling-480.webp 480w, /website_torrepulia_theme/static/src/cinematic/owner/process-bottling.webp 586w" sizes="(min-width: 992px) 240px, 128px" alt="Confezionamento dell'olio La Regina in frantoio" width="586" height="586" loading="lazy"/>
                                <div>
                                    <h3>Il confezionamento</h3>
                                    <p>Confezioniamo l&#8217;olio in frantoio, in bottiglia, latta o Bag in Box, e lo portiamo nel nostro magazzino. Filtrato o, per chi lo preferisce, non filtrato.</p>
                                </div>
                            </li>
                        </ol>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <template id="s_torrepulia_pairings" name="Torrepulia A Tavola">
        <section class="s_torrepulia_snippet tp-section tp-oil-pairings o_colored_level" data-snippet="s_torrepulia_pairings" data-name="A tavola">
            <div class="container">
                <h2 class="text-start mb-5">Un filo d'olio.<br/>Un altro sapore.</h2>
                <div class="row g-5">
                    <div class="col-12 col-md-6 o_colored_level"><h3 class="h4 mb-3">Pane e verdure, a crudo</h3><p>Su una bruschetta appena grigliata, su un'insalata o sulle verdure: il modo pi&#249; diretto di incontrare la Peranzana.</p></div>
                    <div class="col-12 col-md-6 o_colored_level"><h3 class="h4 mb-3">Pesce e primi piatti</h3><p>A crudo sul pesce alla griglia o sulla pasta appena scolata, per ritrovare il suo finale erbaceo.</p></div>
                </div>
            </div>
        </section>
    </template>
</odoo>
