<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_torrepulia_catalog" name="Torrepulia Catalogo">
        <section class="s_dynamic_snippet_products_grid s_dynamic_snippet_products s_dynamic oe_website_sale tp-section tp-catalog o_wsale_products_opt_layout_catalog o_wsale_products_opt_design_thumbs o_wsale_products_opt_thumb_contain o_wsale_products_opt_name_color_regular o_wsale_products_opt_cc1"
            data-snippet="s_dynamic_snippet_products_grid" data-name="Catalogo La Regina"
            data-template-key="website_sale.dynamic_filter_template_product_product_products_item"
            t-att-data-filter-id="env.ref('website_sale.dynamic_filter_all_products').id"
            data-number-of-records="4" data-grid-columns="4" data-mobile-columns="1"
            data-product-names="La Regina" data-custom-template-data="{}">
            <div class="container s_dynamic_snippet_container">
                <div class="tp-section-heading s_dynamic_snippet_title"><h2>Scegli il tuo La Regina.</h2><a class="tp-text-link" href="/shop">Tutti i prodotti <i class="oi ms-2" data-icon="arrow_forward" aria-hidden="true"/></a></div>
                <div class="s_dynamic_snippet_content o_not_editable">
                    <div class="dynamic_snippet_template"/>
                </div>
            </div>
        </section>
    </template>
    <template id="s_torrepulia_story_opening" name="Torrepulia Famiglia">
        <section class="s_torrepulia_snippet tp-section tp-story-intro tp-about-opening o_colored_level" data-snippet="s_torrepulia_story_opening" data-name="Famiglia Leone">
            <div class="tp-about-container">
                <h1>Tre generazioni,<br/>la stessa terra.</h1>
                <p class="tp-about-subtitle">Siamo la famiglia Leone, olivicoltori a Torremaggiore dal secondo dopoguerra. Coltiviamo la Peranzana e dal 2020 vendiamo il nostro olio con il marchio Torrepulia.</p>
                <figure class="tp-about-photo">
                    <img class="img img-fluid" src="/website_torrepulia_theme/static/src/cinematic/owner/about-franco-salvatore.webp" srcset="/website_torrepulia_theme/static/src/cinematic/owner/about-franco-salvatore-750.webp 750w, /website_torrepulia_theme/static/src/cinematic/owner/about-franco-salvatore.webp 1035w" sizes="(max-width: 575px) calc(100vw - 44px), (max-width: 1199px) calc(100vw - 80px), (max-width: 1440px) calc(100vw - 128px), 1312px" alt="Franco e Salvatore Leone tra gli ulivi di famiglia, in bianco e nero" width="1035" height="690" loading="eager" fetchpriority="high"/>
                    <figcaption>Franco e Salvatore, la terza generazione.</figcaption>
                </figure>
            </div>
        </section>
    </template>
    <template id="s_torrepulia_story_chapters" name="Torrepulia Generazioni">
        <section class="s_torrepulia_snippet tp-section tp-story-chapters tp-about-generations o_colored_level" data-snippet="s_torrepulia_story_chapters" data-name="Tre generazioni">
            <div class="tp-about-container">
                <h2 class="visually-hidden">Tre generazioni della famiglia Leone</h2>
                <!-- DOM order stays chronological when the stagger collapses on mobile. -->
                <div class="tp-about-grid">
                    <article>
                        <p class="tp-about-year">1945</p>
                        <h3>Si riparte dalla terra.</h3>
                        <p>Tornato dal fronte, nonno Santino Vincenzo sceglie di ripartire dalla terra. Cura con le sue mani i pochi ulivi ereditati, gli stessi che oggi sono i nostri ulivi secolari, e insegna il mestiere a suo figlio Michele.</p>
                    </article>
                    <article>
                        <p class="tp-about-year">1980</p>
                        <h3>L&#8217;azienda cresce.</h3>
                        <p>Con pap&#224; Michele l&#8217;azienda cresce fino a oltre 1000 piante di ulivo nell&#8217;agro di Torremaggiore. Il modo di lavorare resta quello imparato dal nonno.</p>
                    </article>
                    <article>
                        <p class="tp-about-year">2020</p>
                        <h3>Nasce Torrepulia.</h3>
                        <p>Noi, Franco e Salvatore, siamo cresciuti tra questi ulivi e il profumo delle olive appena frante. Con studi in economia e ingegneria gestionale, nel 2020 abbiamo fondato Torrepulia per vendere il nostro olio direttamente a chi lo usa, senza intermediari.</p>
                    </article>
                </div>
            </div>
        </section>
    </template>
    <template id="s_torrepulia_sensory" name="Torrepulia Profilo Sensoriale">
        <section id="profilo" class="s_torrepulia_snippet tp-section tp-sensory" data-snippet="s_torrepulia_sensory" data-name="Profilo sensoriale">
            <div class="container"><div class="row g-5"><div class="col-lg-5"><h2>Un equilibrio<br/>da assaporare.</h2><p class="lead">Un fruttato medio che sa di oliva appena colta.</p></div><div class="col-lg-6 offset-lg-1"><dl class="tp-sensory-list"><dt>Alla vista</dt><dd>Verde brillante con riflessi dorati.</dd><dt>Al profumo</dt><dd>Prima il verde del <strong>pomodoro</strong> e del <strong>carciofo</strong>, poi la <strong>mandorla fresca</strong>, l&#8217;erba e il grano appena tagliati.</dd><dt>Al gusto</dt><dd>Amaro e piccante ci sono, ma con garbo: si bilanciano e non coprono mai il resto.</dd><dt>Al palato</dt><dd>Scorre fluido e lascia la bocca pulita. Un olio armonico, con un&#8217;acidit&#224; bassa.</dd></dl></div></div></div>
        </section>
    </template>
    <template id="s_torrepulia_landscape" name="Torrepulia Paesaggio">
        <section class="s_torrepulia_snippet tp-landscape" data-snippet="s_torrepulia_landscape" data-name="Alto Tavoliere">
            <img src="/website_torrepulia_theme/static/src/cinematic/owner/orizzonte-tavoliere-1920.webp" srcset="/website_torrepulia_theme/static/src/cinematic/owner/orizzonte-tavoliere-640.webp 640w, /website_torrepulia_theme/static/src/cinematic/owner/orizzonte-tavoliere-1280.webp 1280w, /website_torrepulia_theme/static/src/cinematic/owner/orizzonte-tavoliere-1920.webp 1920w" sizes="100vw" alt="I nostri vigneti e i campi dell'Alto Tavoliere fino all'orizzonte, visti da un tetto di coppi" width="1920" height="1080" loading="eager" fetchpriority="high"/>
            <div class="container"><h1>Il nostro orizzonte<br/>&#232; l'Alto Tavoliere.</h1><p>Torremaggiore, Puglia.</p></div>
        </section>
    </template>
    <template id="s_torrepulia_land_story" name="Torrepulia Terra">
        <section class="s_torrepulia_snippet tp-section tp-land-where o_colored_level" data-snippet="s_torrepulia_land_story" data-name="Dove siamo">
            <div class="container">
                <div class="row gy-5 gx-5 align-items-center">
                    <div class="col-12 col-lg-6 o_colored_level">
                        <h2>Nel nord della Puglia.</h2>
                        <p class="lead">I nostri ulivi sono nell&#8217;agro di Torremaggiore, in provincia di Foggia: &#232; l&#8217;Alto Tavoliere, dove la pianura comincia a salire verso i Monti Dauni.</p>
                        <p>Estati calde e asciutte, inverni freddi, il vento che attraversa la pianura: &#232; il clima in cui la Peranzana &#232; di casa. Tra Torremaggiore, San Severo e San Paolo di Civitate si concentra la sua coltivazione.</p>
                        <a class="tp-oil-process-link text-decoration-none fw-bold d-inline-flex align-items-center gap-2" href="/l-olio">Conosci la Peranzana <img class="icon tp-icon-out" src="/website_torrepulia_theme/static/src/cinematic/icons/arrow-up-right.svg" alt="" width="20" height="20"/></a>
                    </div>
                    <div class="col-12 col-lg-6 o_colored_level">
                        <figure class="tp-oil-map">
                            <t t-call="website_torrepulia_theme.s_puglia_map"/>
                        </figure>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
