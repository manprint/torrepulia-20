<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Owner-supplied test report of the 2024 harvest (19/11/2024), published whole as a PDF.
         Static, editable values: the Builder keeps ownership of the section. -->
    <template id="s_torrepulia_oil_analysis" name="Torrepulia Analisi del raccolto">
        <section id="analisi" class="s_torrepulia_snippet tp-section tp-analysis o_colored_level" data-snippet="s_torrepulia_oil_analysis" data-name="Analisi del raccolto">
            <div class="container">
                <div class="tp-analysis-head">
                    <h2>Le analisi del raccolto 2024.</h2>
                    <p>Il 19 novembre 2024 il frantoio ha analizzato il nostro olio. Pubblichiamo il rapporto di prova intero, cos&#236; come ci &#232; stato consegnato.</p>
                </div>
                <div class="tp-analysis-key">
                    <div class="tp-analysis-fact">
                        <p class="tp-analysis-value">0,17 %</p>
                        <h3>Acidit&#224;</h3>
                        <p>Il limite dell&#8217;extravergine &#232; 0,80 %. Resta bassa se le olive sono sane e molite presto.</p>
                    </div>
                    <div class="tp-analysis-fact">
                        <p class="tp-analysis-value">4,91</p>
                        <h3>Perossidi</h3>
                        <p>Il limite &#232; 20 meq O&#8322;/kg. Pi&#249; il valore &#232; basso, meno l&#8217;olio si &#232; ossidato.</p>
                    </div>
                    <div class="tp-analysis-fact">
                        <p class="tp-analysis-value">589 <small>mg/kg</small></p>
                        <h3>Polifenoli totali</h3>
                        <p>Sono i composti che danno all&#8217;olio l&#8217;amaro e il piccante.</p>
                    </div>
                </div>
                <div class="tp-lab-wrap">
                    <table class="tp-lab">
                        <caption class="visually-hidden">Analisi del raccolto 2024 confrontata con i limiti di legge per l'olio extravergine</caption>
                        <thead><tr><th scope="col">Parametro</th><th scope="col">Valore</th><th scope="col">Limite extravergine</th><th scope="col" class="tp-lab-scale-head">Quota del limite</th></tr></thead>
                        <tbody>
                            <tr><th scope="row">Acidit&#224;</th><td class="tp-lab-value">0,17 %</td><td class="tp-lab-limit">0,80 %</td><td><span class="tp-lab-scale" role="img" aria-label="21 per cento del limite"><span style="width: 21%"/></span></td></tr>
                            <tr><th scope="row">Perossidi</th><td class="tp-lab-value">4,91 meq O&#8322;/kg</td><td class="tp-lab-limit">20</td><td><span class="tp-lab-scale" role="img" aria-label="25 per cento del limite"><span style="width: 25%"/></span></td></tr>
                            <tr><th scope="row">K232</th><td class="tp-lab-value">1,87</td><td class="tp-lab-limit">2,50</td><td><span class="tp-lab-scale" role="img" aria-label="75 per cento del limite"><span style="width: 75%"/></span></td></tr>
                            <tr><th scope="row">K270</th><td class="tp-lab-value">0,12</td><td class="tp-lab-limit">0,22</td><td><span class="tp-lab-scale" role="img" aria-label="55 per cento del limite"><span style="width: 55%"/></span></td></tr>
                            <tr><th scope="row">&#916;K</th><td class="tp-lab-value">0,00</td><td class="tp-lab-limit">0,01</td><td><span class="tp-lab-scale" role="img" aria-label="0 per cento del limite"><span style="width: 0%"/></span></td></tr>
                            <tr><th scope="row">Acido oleico</th><td class="tp-lab-value">70,2 %</td><td class="tp-lab-limit">55 - 83 %</td><td/></tr>
                            <tr><th scope="row">Polifenoli totali</th><td class="tp-lab-value">589 mg/kg</td><td class="tp-lab-limit">nessun limite</td><td/></tr>
                            <tr><th scope="row">Tocoferoli totali</th><td class="tp-lab-value">244 mg/kg</td><td class="tp-lab-limit">nessun limite</td><td/></tr>
                        </tbody>
                    </table>
                </div>
                <div class="tp-analysis-foot">
                    <p>Analisi rapida in frantoio con strumento XDS Rapid Liquid Analyzer, non di un laboratorio accreditato. I valori riguardano il campione analizzato del raccolto 2024.</p>
                    <a class="btn btn-outline-primary" href="/website_torrepulia_theme/static/src/docs/rapporto-di-prova-raccolto-2024.pdf" target="_blank" rel="noopener">Rapporto di prova del frantoio (PDF, 123 KB)</a>
                </div>
            </div>
        </section>
    </template>

