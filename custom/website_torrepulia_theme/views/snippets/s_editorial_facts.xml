<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The analysis comes from the latest harvest profile in the backend (torrepulia.oil.profile):
         the Builder owns the section, the content is loaded when the page runs. -->
    <template id="s_torrepulia_oil_analysis" name="Torrepulia Analisi del raccolto">
        <section id="analisi" class="s_torrepulia_snippet tp-section tp-analysis o_colored_level" data-snippet="s_torrepulia_oil_analysis" data-name="Analisi del raccolto">
            <div class="container">
                <div class="tp-analysis-content o_not_editable">
                    <div class="tp-analysis-head">
                        <h2>Le analisi del raccolto.</h2>
                        <p>Pubblichiamo qui il rapporto di prova intero, cos&#236; come ci viene consegnato.</p>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <template id="oil_analysis_content" name="Analisi del raccolto: contenuto">
        <t t-if="profile">
            <div class="tp-analysis-head">
                <h2>Le analisi del raccolto <t t-out="profile.harvest_year"/>.</h2>
                <p><t t-if="profile.report_date">Il <t t-out="profile._torrepulia_report_day()"/> il frantoio ha analizzato il nostro olio. </t>Pubblichiamo il rapporto di prova intero, cos&#236; come ci &#232; stato consegnato.</p>
            </div>
            <div class="tp-analysis-key">
                <div t-if="profile.acidity" class="tp-analysis-fact">
                    <p class="tp-analysis-value" t-out="profile._torrepulia_value('acidity', 2, ' %')"/>
                    <h3>Acidit&#224;</h3>
                    <p>Il limite dell&#8217;extravergine &#232; 0,80 %. Resta bassa se le olive sono sane e molite presto.</p>
                </div>
                <div t-if="profile.peroxides" class="tp-analysis-fact">
                    <p class="tp-analysis-value" t-out="profile._torrepulia_value('peroxides', 2)"/>
                    <h3>Perossidi</h3>
                    <p>Il limite &#232; 20 meq O&#8322;/kg. Pi&#249; il valore &#232; basso, meno l&#8217;olio si &#232; ossidato.</p>
                </div>
                <div t-if="profile.polyphenols" class="tp-analysis-fact">
                    <p class="tp-analysis-value"><t t-out="profile._torrepulia_value('polyphenols', 0)"/> <small>mg/kg</small></p>
                    <h3>Polifenoli totali</h3>
                    <p>Sono i composti che danno all&#8217;olio l&#8217;amaro e il piccante.</p>
                </div>
            </div>
            <div class="tp-lab-wrap">
                <table class="tp-lab">
                    <caption class="visually-hidden">Analisi del raccolto <t t-out="profile.harvest_year"/> confrontata con i limiti di legge per l'olio extravergine</caption>
                    <thead><tr><th scope="col">Parametro</th><th scope="col">Valore</th><th scope="col">Limite extravergine</th><th scope="col" class="tp-lab-scale-head">Quota del limite</th></tr></thead>
                    <tbody>
                        <tr t-foreach="profile._torrepulia_lab_rows()" t-as="row">
                            <th scope="row" t-out="row['label']"/>
                            <td class="tp-lab-value" t-out="row['value']"/>
                            <td class="tp-lab-limit" t-out="row['limit']"/>
                            <td><span t-if="row['ratio'] is not None" class="tp-lab-scale" role="img" t-att-aria-label="'%s per cento del limite' % row['ratio']"><span t-attf-style="width: #{row['ratio']}%"/></span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div t-if="profile.analysis_note or profile._torrepulia_report_link()" class="tp-analysis-foot">
                <p t-if="profile.analysis_note" t-out="profile.analysis_note"/>
                <a t-if="profile._torrepulia_report_link()" class="btn btn-outline-primary" t-att-href="profile._torrepulia_report_link()" target="_blank" rel="noopener">Rapporto di prova del frantoio (PDF)</a>
            </div>
        </t>
        <div t-else="" class="tp-analysis-head">
            <h2>Le analisi del raccolto <t t-out="season"/>.</h2>
            <p>Appena molito l&#8217;olio nuovo lo facciamo analizzare e pubblichiamo qui il rapporto di prova intero, cos&#236; come ci viene consegnato.</p>
        </div>
    </template>

    <!-- Page closings: buy from stock now, or reserve the new oil. Different from the home and footer closings. -->
    <template id="s_torrepulia_choice_oil" name="Torrepulia Scorte o olio nuovo">
        <section class="s_torrepulia_snippet tp-section tp-choice o_colored_level" data-snippet="s_torrepulia_choice_oil" data-name="Scorte o olio nuovo">
            <div class="container">
                <div class="row gy-5 gx-5">
                    <div class="col-12 col-lg-5 o_colored_level">
                        <h2>Ora che la conosci, assaggiala.</h2>
                        <p>Due modi per avere La Regina a casa.</p>
                    </div>
                    <div class="col-12 col-lg-7 o_colored_level">
                        <div class="tp-choice-options">
                            <div class="tp-choice-option">
                                <div><h3>Dalle scorte</h3><p>I formati disponibili partono subito, con consegna in 24-72 ore lavorative.</p></div>
                                <a class="btn btn-primary" href="/shop">Ordina dalle scorte</a>
                            </div>
                            <div class="tp-choice-option">
                                <div><h3>Olio nuovo</h3><p>L&#8217;olio della nuova raccolta, appena molito. Prenoti senza anticipo e paghi alla conferma dell&#8217;ordine.</p></div>
                                <a class="btn btn-outline-primary" href="/prenotailtuoolio">Prenota l&#8217;olio nuovo</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <template id="s_torrepulia_choice_family" name="Torrepulia Lettera della famiglia">
        <section class="s_torrepulia_snippet tp-section tp-choice o_colored_level" data-snippet="s_torrepulia_choice_family" data-name="Lettera della famiglia">
            <div class="container">
                <img class="img img-fluid tp-choice-photo" src="/website_torrepulia_theme/static/src/cinematic/owner/chioma-controluce-1280.webp" srcset="/website_torrepulia_theme/static/src/cinematic/owner/chioma-controluce-640.webp 640w, /website_torrepulia_theme/static/src/cinematic/owner/chioma-controluce-960.webp 960w, /website_torrepulia_theme/static/src/cinematic/owner/chioma-controluce-1280.webp 1280w" sizes="(min-width: 1320px) 1272px, calc(100vw - 48px)" alt="La chioma di un ulivo controluce, vista dal basso" width="1280" height="533" loading="lazy"/>
                <div class="row gy-5 gx-5">
                    <div class="col-12 col-lg-5 o_colored_level">
                        <h2>Ti aspettiamo alla prossima raccolta.</h2>
                        <p>Ogni anno, tra ottobre e novembre, raccogliamo le olive e moliamo l&#8217;olio nuovo. Se vuoi assaggiarlo tra i primi, prenotalo: lo spediamo appena &#232; pronto.</p>
                        <p class="tp-choice-signature">Franco e Salvatore Leone</p>
                    </div>
                    <div class="col-12 col-lg-7 o_colored_level">
                        <div class="tp-choice-options">
                            <div class="tp-choice-option">
                                <div><h3>Olio nuovo</h3><p>Prenoti senza anticipo e paghi alla conferma dell&#8217;ordine.</p></div>
                                <a class="btn btn-primary" href="/prenotailtuoolio">Prenota l&#8217;olio nuovo</a>
                            </div>
                            <div class="tp-choice-option">
                                <div><h3>Dalle scorte</h3><p>I formati disponibili partono subito, con consegna in 24-72 ore lavorative.</p></div>
                                <a class="btn btn-outline-primary" href="/shop">Ordina dalle scorte</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Torremaggiore's castle: Raimondo di Sangro was born there on 30 January 1710 (Museo Sansevero, FAI). -->
    <template id="s_torrepulia_land_history" name="Torrepulia Il castello e la Peranzana">
        <section class="s_torrepulia_snippet tp-section tp-land-history o_colored_level" data-snippet="s_torrepulia_land_history" data-name="Il castello e la Peranzana">
            <div class="container">
                <div class="row gy-4 gx-5">
                    <div class="col-12 col-lg-4 o_colored_level">
                        <p class="tp-land-year">1710</p>
                    </div>
                    <div class="col-12 col-lg-8 o_colored_level">
                        <h2>Il castello e la Peranzana.</h2>
                        <p>Nel castello ducale di Torremaggiore nacque, il 30 gennaio 1710, Raimondo di Sangro, principe di Sansevero: scienziato e inventore, una delle figure pi&#249; curiose del Settecento napoletano. Alla sua famiglia la tradizione lega l&#8217;arrivo della Peranzana nell&#8217;Alto Tavoliere.</p>
                        <p>Il nome Torrepulia nasce da qui: Torremaggiore e la Puglia, le nostre radici.</p>
                    </div>
                </div>
            </div>
        </section>
    </template>
    <template id="s_torrepulia_land_grove" name="Torrepulia Uliveto">
        <section class="s_torrepulia_snippet tp-land-grove o_colored_level" data-snippet="s_torrepulia_land_grove" data-name="Uliveto">
            <figure>
                <img class="img img-fluid" src="/website_torrepulia_theme/static/src/cinematic/owner/uliveto-file-1920.webp" srcset="/website_torrepulia_theme/static/src/cinematic/owner/uliveto-file-640.webp 640w, /website_torrepulia_theme/static/src/cinematic/owner/uliveto-file-1280.webp 1280w, /website_torrepulia_theme/static/src/cinematic/owner/uliveto-file-1920.webp 1920w" sizes="100vw" alt="Le file dell'uliveto di famiglia nell'agro di Torremaggiore, con la luna nel cielo" width="1920" height="1080" loading="lazy"/>
                <figcaption class="container">Le file del nostro uliveto, nell&#8217;agro di Torremaggiore.</figcaption>
            </figure>
        </section>
    </template>
    <template id="s_torrepulia_choice_land" name="Torrepulia Il sapore di questa terra">
        <section class="s_torrepulia_snippet tp-section tp-choice o_colored_level" data-snippet="s_torrepulia_choice_land" data-name="Il sapore di questa terra">
            <div class="container">
                <div class="row gy-5 gx-5">
                    <div class="col-12 col-lg-5 o_colored_level">
                        <h2>Il sapore di questa terra, a casa tua.</h2>
                        <p>La Regina &#232; l&#8217;olio dell&#8217;Alto Tavoliere: puoi averla subito o aspettare la nuova raccolta.</p>
                    </div>
                    <div class="col-12 col-lg-7 o_colored_level">
                        <div class="tp-choice-options">
                            <div class="tp-choice-option">
                                <div><h3>Dalle scorte</h3><p>I formati disponibili partono subito, con consegna in 24-72 ore lavorative.</p></div>
                                <a class="btn btn-primary" href="/shop">Ordina dalle scorte</a>
                            </div>
                            <div class="tp-choice-option">
                                <div><h3>Olio nuovo</h3><p>L&#8217;olio della nuova raccolta, appena molito. Prenoti senza anticipo e paghi alla conferma dell&#8217;ordine.</p></div>
                                <a class="btn btn-outline-primary" href="/prenotailtuoolio">Prenota l&#8217;olio nuovo</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Three verifiable facts after the home hero, each linking to the page that proves it. -->
    <template id="s_torrepulia_home_facts" name="Torrepulia Tre fatti">
        <section class="s_torrepulia_snippet tp-home-facts o_colored_level" data-snippet="s_torrepulia_home_facts" data-name="Tre fatti">
            <div class="container">
                <ul class="tp-home-facts-list">
                    <li><a href="/territorio"><strong>Oltre 1.500</strong><span>ulivi nell&#8217;agro di Torremaggiore</span></a></li>
                    <li><a href="/l-olio#processo"><strong>Entro 6 ore</strong><span>dalla raccolta alla molitura</span></a></li>
                    <li><a href="/aboutus"><strong>Dal 1945</strong><span>tre generazioni sulla stessa terra</span></a></li>
                </ul>
            </div>
        </section>
    </template>
    <!-- The full Bag in Box explainer lives on its product page; the migration sets the real product link. -->
    <template id="s_torrepulia_bib_line" name="Torrepulia Bag in Box in breve">
        <section class="s_torrepulia_snippet tp-bib-line o_colored_level" data-snippet="s_torrepulia_bib_line" data-name="Bag in Box in breve">
            <div class="container">
                <div class="tp-bib-line-card">
                    <img src="/website_torrepulia_theme/static/src/cinematic/images/bag-box-transparent-240.webp" alt="Bag in Box La Regina da 5 litri" width="219" height="240" loading="lazy"/>
                    <div class="tp-bib-line-copy">
                        <p class="tp-bib-line-label">Il formato che consigliamo</p>
                        <p>Bag in Box da 5 litri: la sacca si contrae mentre versi, l&#8217;aria non entra e l&#8217;olio resta protetto fino all&#8217;ultima goccia.</p>
                    </div>
                    <a class="tp-bib-line-link" href="/shop?search=Bag">Come funziona <img class="icon" src="/website_torrepulia_theme/static/src/cinematic/icons/arrow-up-right.svg" alt="" width="20" height="20"/></a>
                </div>
            </div>
        </section>
