<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_torrepulia_product_showcase" name="Torrepulia Product Showcase">
        <section class="s_torrepulia_snippet tp-section tp-section-dark" data-snippet="s_torrepulia_product_showcase" data-name="Torrepulia Prodotto">
            <div class="container">
                <div class="row g-5 align-items-center">
                    <div class="col-lg-6">
                        <div class="tp-product-stage">
                            <img src="/website_torrepulia_theme/static/src/img/content/la-regina-bottiglia-500ml.jpeg" alt="Bottiglia olio extravergine La Regina 500 ml" loading="lazy"/>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <p class="tp-eyebrow">La Regina</p>
                        <h2 class="display-3">Un omaggio alla cultivar più pregiata dell'Alto Tavoliere.</h2>
                        <p class="lead mt-4">La Regina è ottenuto unicamente da olive di varietà Peranzana, cultivar a duplice attitudine adatta sia all'estrazione dell'olio sia alla trasformazione in oliva da tavola.</p>
                        <p class="tp-muted">Il formato in bottiglia di vetro scuro protegge l'olio dalla luce ed è dotato di tappo antirabbocco.</p>
                        <a class="btn btn-light btn-lg mt-3" href="/shop">Vai allo shop</a>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
