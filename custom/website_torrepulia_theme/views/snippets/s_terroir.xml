<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_torrepulia_terroir" name="Torrepulia Terroir">
        <section class="s_torrepulia_snippet tp-section tp-section-dark" data-snippet="s_torrepulia_terroir" data-name="Torrepulia Territorio">
            <div class="container">
                <div class="tp-editorial-grid">
                    <div class="tp-image-frame">
                        <img class="tp-img-cover" src="/website_torrepulia_theme/static/src/img/content/olive-grove-editorial.jpg" alt="Uliveto nell'Alto Tavoliere" loading="lazy"/>
                    </div>
                    <div>
                        <p class="tp-eyebrow">Territorio</p>
                        <h2 class="display-4">Torremaggiore, luce e terreno dell'Alto Tavoliere.</h2>
                        <p class="lead mt-4">L'azienda è situata nell'Alto Tavoliere delle Puglie, nel territorio di Torremaggiore in provincia di Foggia.</p>
                        <p class="tp-muted">Il vento, il terreno fertile del Tavoliere e la luce del sole della Puglia si uniscono al lavoro agricolo della famiglia Leone.</p>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
