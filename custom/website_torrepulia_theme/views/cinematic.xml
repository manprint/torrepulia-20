<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <template id="s_cinematic_0" name="Apertura Torrepulia"><section class="hero mc-section mc-banner-contained mc-static-hero o_colored_level o_full_screen_height" aria-labelledby="hero-title" data-snippet="s_cinematic_0" data-name="Apertura Torrepulia">
      <picture>
        <source srcset="/website_torrepulia_theme/static/src/cinematic/images/hero-foglie-640.webp 640w, /website_torrepulia_theme/static/src/cinematic/images/hero-foglie-1280.webp 1280w, /website_torrepulia_theme/static/src/cinematic/images/hero-foglie-1920.webp 1920w" sizes="(max-width: 760px) 1650px, 100vw">
        <img class="hero-photo" src="/website_torrepulia_theme/static/src/cinematic/images/hero-foglie-1920.webp" alt="La Regina Torrepulia su pietra, tra foglie di ulivo" fetchpriority="high" loading="eager" data-mimetype="undefined" style="width: 100% !important"/>
      </source></picture>
      <div class="hero-shade"/>
      <div class="hero-copy"><p><strong><font class="text-o-color-2"><span data-text-effect="{&quot;preset&quot;:&quot;blurred_black&quot;,&quot;shadows&quot;:[{&quot;shadowBlur&quot;:&quot;10px&quot;}]}" style="text-shadow: rgba(0, 0, 0, 0.5) 2px 2px 10px;">LA NOSTRA TERRA. IL TUO OLIO.</span></font></strong></p><h1 id="hero-title"><span class="display-2-fs">Olio extravergine Peranzana</span></h1><p class="hero-description">A Torremaggiore coltiviamo gli ulivi della nostra famiglia. Dalle nostre olive nasce La Regina: l’olio extravergine monovarietale Peranzana, da scegliere nel formato più adatto alla tua tavola e spedito direttamente dalla Puglia.<br/><br/></p><a class="button light o_translate_inline" href="#formati">Scegli il tuo formato<img class="icon" src="/website_torrepulia_theme/static/src/cinematic/icons/arrow-up-right.svg" alt="" loading="lazy" data-mimetype="undefined"/></a></div>
      <div class="hero-bottom"><span>Una storia di famiglia da tre generazioni.</span><a href="#famiglia" class="o_translate_inline">Scopri la nostra storia <img class="icon" src="/website_torrepulia_theme/static/src/cinematic/icons/arrow-right.svg" alt="" loading="lazy" data-mimetype="undefined"/></a></div>
    </section></template>
  <template id="s_cinematic_1" name="La Regina"><section id="regina" class="regina section-pad mc-section o_colored_level" aria-labelledby="regina-title" data-snippet="s_cinematic_1" data-name="La Regina">
      <div class="regina-layout">
        <h2 id="regina-title">La Regina.<br/>La nostra<br/> <em>Peranzana.</em></h2>
        <a class="bottle-portrait" href="/shop" aria-label="Scopri La Regina e i suoi formati"><img src="/website_torrepulia_theme/static/src/cinematic/owner/image-615.webp" alt="Olio extravergine di oliva Peranzana" class="img img-fluid o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="700" data-mimetype-before-conversion="image/webp" data-mimetype="image/webp" loading="eager" title="LA REGINA / BOTTIGLIA IN VETRO 500 ML"/><span>LA REGINA / 500 ML</span></a>
        <div class="regina-copy"><p><strong>Il carattere della nostra terra.</strong></p><p>L’olio extravergine La Regina nasce dalle olive Peranzana dei nostri uliveti di Torremaggiore, nel nord della Puglia. Un fruttato medio-intenso con sentori di pomodoro verde, carciofo e mandorla fresca; amaro e piccante ben equilibrati. È l’olio da usare a crudo, su bruschette, verdure e zuppe.</p><a class="text-link" href="#formati">Scegli il tuo formato <img class="icon" src="/website_torrepulia_theme/static/src/cinematic/icons/arrow-right.svg" alt="" loading="lazy"/></a></div>
      </div>
    </section></template>
  <template id="s_cinematic_2" name="Famiglia Leone"><section id="famiglia" class="family section-pad mc-section mc-family-editorial o_colored_level" aria-labelledby="family-title" data-snippet="s_cinematic_2" data-name="Famiglia Leone">
      <div class="mc-family-composition">
        <div class="family-heading"><h2 id="family-title">Prima dell'olio,<br/><em>una famiglia.</em></h2><p>Tre generazioni, gli stessi ulivi.</p></div>
        <div class="family-media">
          <figure class="family-today"><div class="mc-family-photo"><img src="/website_torrepulia_theme/static/src/cinematic/owner/image-656.webp" alt="" class="img img-fluid o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="941" data-mimetype-before-conversion="image/webp" data-mimetype="image/webp" srcset="/website_torrepulia_theme/static/src/cinematic/owner/image-657.webp 750w, /website_torrepulia_theme/static/src/cinematic/owner/image-656.webp 941w" loading="lazy"/></div><figcaption>Franco e Salvatore. Oggi.</figcaption></figure>
          <figure class="family-archive"><div class="mc-family-photo"><img src="/website_torrepulia_theme/static/src/cinematic/images/family-archive-690.webp" alt="Foto d'archivio: papà Michele sul trattore e nonno Santino Vincenzo" loading="lazy" style="width: 100%; height: auto;"/></div><figcaption>Papà Michele e nonno Santino Vincenzo.</figcaption></figure>
        <p class="mc-family-imprint"><strong>Leone</strong><span>Torremaggiore, dal 1945.</span></p></div>
        <div class="family-story"><p>Nonno Santino Vincenzo, tornato dalla guerra, ha ripreso a curare i pochi ulivi di famiglia, gli stessi che oggi sono secolari; papà Michele ha fatto crescere l'uliveto fino a oltre 1.500 piante. Noi, Franco e Salvatore, siamo cresciuti tra quegli alberi e il profumo delle olive appena frante. Nel 2020 abbiamo fondato Torrepulia per portare il nostro olio direttamente sulla tua tavola.</p>
          <a class="text-link" href="/aboutus">Scopri la storia della famiglia Leone <img class="icon" src="/website_torrepulia_theme/static/src/cinematic/icons/arrow-up-right.svg" alt="" loading="lazy"/></a>
        </div>
      </div>
    </section>
    </template>
  <template id="s_cinematic_3" name="Peranzana"><section id="peranzana" class="peranzana mc-section o_colored_level mc-peranzana-editorial" aria-labelledby="peranzana-title" data-snippet="s_cinematic_3" data-name="Peranzana">
      <div class="mc-peranzana-opening"><div class="mc-peranzana-heading"><h2 id="peranzana-title">Peranzana.<br/><em>La nostra origine.</em></h2><span class="photo-caption">Solo Peranzana, solo dai nostri ulivi.</span></div><div class="peranzana-image"><img src="/website_torrepulia_theme/static/src/cinematic/owner/image-683.webp" alt="" class="img img-fluid o_we_custom_image o_attachment_pending_record_id" data-format-mimetype="image/webp" data-resize-width="1160" data-mimetype-before-conversion="image/webp" data-mimetype="image/webp" data-aspect-ratio="16/9" data-width="2400" data-height="1350" data-scale-x="1" data-scale-y="1" srcset="/website_torrepulia_theme/static/src/cinematic/owner/image-684.webp 750w, /website_torrepulia_theme/static/src/cinematic/owner/image-685.webp 900w, /website_torrepulia_theme/static/src/cinematic/owner/image-683.webp 1160w"/></div>
      </div><div class="peranzana-body section-pad"><div class="mc-peranzana-origin"><h3>Il gusto di<br/>una terra precisa.</h3><p>Coltiviamo i nostri ulivi nell’agro di Torremaggiore, nell’Alto Tavoliere: è la terra d’origine della Peranzana.</p></div><div class="sensory"><div class="sensory-tabs" role="tablist" aria-label="Profilo sensoriale"><button role="tab" aria-selected="true" aria-controls="sensory-panel" id="aroma-tab" data-sensory="aroma" tabindex="0"><img class="mc-editorial-icon" src="/website_torrepulia_theme/static/src/cinematic/icons/leaf.svg" alt="" aria-hidden="true" loading="lazy"/>Il profumo</button><button role="tab" aria-selected="false" tabindex="-1" aria-controls="sensory-panel" id="taste-tab" data-sensory="taste"><img class="mc-editorial-icon" src="/website_torrepulia_theme/static/src/cinematic/icons/droplet.svg" alt="" aria-hidden="true" loading="lazy"/>Il gusto</button><button role="tab" aria-selected="false" tabindex="-1" aria-controls="sensory-panel" id="table-tab" data-sensory="table"><img class="mc-editorial-icon" src="/website_torrepulia_theme/static/src/cinematic/icons/utensils.svg" alt="" aria-hidden="true" loading="lazy"/>A tavola</button></div><div class="mc-sensory-panels"><div class="mc-sensory-panel" data-panel="aroma" role="tabpanel"><p class="sensory-title">Pomodoro verde.<br/>Carciofo e mandorla.</p><p class="sensory-text">La Peranzana ha un profilo elegante e armonico. Al naso un fruttato medio-intenso: prima il verde del pomodoro e del carciofo, poi la mandorla fresca.</p></div><div class="mc-sensory-panel" data-panel="taste" role="tabpanel" hidden=""><p class="sensory-title">Morbido.<br/>Equilibrato.</p><p class="sensory-text">In bocca è morbido e rotondo. Amaro e piccante si sentono, delicati e ben bilanciati tra loro, senza mai coprire il resto. Il finale è pulito, con un’acidità bassa.</p></div><div class="mc-sensory-panel" data-panel="table" role="tabpanel" hidden=""><p class="sensory-title">Un filo a crudo.</p><p class="sensory-text">Su bruschette calde, zuppe di legumi, insalate, carpacci di carne o pesce e sulla pasta della tradizione pugliese.</p></div></div></div></div>
      <div class="process section-pad"><div class="process-intro"><h3>Dalla pianta<br/>al frantoio.</h3><p>Seguiamo ogni passaggio di persona. <a class="text-link" href="/l-olio#processo">Come nasce La Regina</a></p></div><article><div class="mc-process-icon" aria-hidden="true"><img class="mc-editorial-icon" src="/website_torrepulia_theme/static/src/cinematic/icons/sprout.svg" alt="" aria-hidden="true" loading="lazy"/></div><span>Ottobre e novembre</span><h4>La raccolta</h4><p>Raccogliamo le olive dalla pianta all’inizio dell’invaiatura, quando il frutto comincia a cambiare colore: è il momento in cui l’oliva è più ricca di polifenoli e di profumi.</p></article><article><div class="mc-process-icon" aria-hidden="true"><img class="mc-editorial-icon" src="/website_torrepulia_theme/static/src/cinematic/icons/thermometer-snowflake.svg" alt="" aria-hidden="true" loading="lazy"/></div><span>Entro 8 ore</span><h4>La molitura</h4><p>Moliamo le olive nel nostro frantoio di fiducia, con estrazione a freddo sotto i 27 °C, e seguiamo la molitura di persona.</p></article></div>
    </section></template>
  <template id="s_cinematic_4" name="A tavola"><section class="culinary mc-section o_colored_level" aria-labelledby="culinary-title" data-snippet="s_cinematic_4" data-name="A tavola"><picture><img src="/website_torrepulia_theme/static/src/cinematic/images/culinary-campaign-1536.webp" alt="Pane grigliato, pomodori e una ciotola di olio su un tavolo di pietra" loading="lazy" style="width: 1536px; height: 1024px;"/></picture><div class="culinary-copy"><h2 id="culinary-title">Il primo assaggio?<br/>Sul pane.</h2><p>Una fetta calda, un filo di La Regina. Poi provalo sulla pasta fresca, sulle verdure o sul pesce alla griglia: pochi ingredienti, l'olio al posto giusto.</p><a class="text-link" href="#formati">Scegli il tuo formato <img class="icon" src="/website_torrepulia_theme/static/src/cinematic/icons/arrow-up-right.svg" alt="" loading="lazy"/></a></div></section>

    </template>
  <template id="s_cinematic_5" name="Formati La Regina"><section id="formati" class="shop section-pad mc-section o_colored_level" aria-labelledby="shop-title" data-snippet="s_cinematic_5" data-name="Formati La Regina">
      <div class="shop-heading"><h2 id="shop-title">La tua tavola.<br/>Il tuo formato.</h2><p>Scegli il formato ideale per la tua cucina.</p></div>
      <div class="mc-catalog o_not_editable"><a href="/shop" class="button dark">Scopri La Regina</a></div></section></template>
  <template id="s_cinematic_6" name="Torremaggiore"><section id="territorio" class="territory mc-section mc-home-closing o_colored_level" aria-labelledby="territory-title" data-snippet="s_cinematic_6" data-name="Torremaggiore"><div class="mc-territory-photo"><img src="/website_torrepulia_theme/static/src/cinematic/owner/closing-landscape-706.webp" class="img img-fluid" loading="lazy" alt="Il paesaggio degli uliveti di Torrepulia a Torremaggiore" style="object-position: 100% 60.1673%;"/></div><div class="territory-copy"><h2 id="territory-title">Torremaggiore.<br/>Da qui, ogni giorno.</h2><p>Il nome Torrepulia unisce Torremaggiore e la Puglia. In questo angolo dell’Alto Tavoliere crescono i nostri ulivi, dai secolari del nonno a quelli piantati da poco: da qui nasce La Regina.</p><a class="text-link" href="/territorio">Il territorio <img class="icon" src="/website_torrepulia_theme/static/src/cinematic/icons/arrow-up-right.svg" alt="" loading="lazy"/></a></div></section></template>
