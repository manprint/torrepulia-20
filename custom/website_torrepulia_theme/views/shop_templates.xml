<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="torrepulia_shop_page" inherit_id="website_sale.products" name="Torrepulia Shop Page" active="False">
        <xpath expr="//div[@id='oe_structure_products_header_shop']" position="inside">
            <section class="tp-shop-intro" data-snippet="s_text_block" data-name="Shop Torrepulia">
                <p>Olio extravergine monovarietale Peranzana. Bottiglie in vetro scuro, latta e Bag in Box: scegli il tuo formato.</p>
            </section>
        </xpath>
        <xpath expr="//div[hasclass('o_wsale_shop_title')]/h1" position="replace">
            <h1 class="tp-shop-title">La Regina, per la tua tavola.</h1>
        </xpath>
        <xpath expr="//div[@id='wrap']" position="attributes">
            <attribute name="class" add="tp-shop-page" separator=" "/>
        </xpath>
        <xpath expr="//h1" position="attributes">
            <attribute name="class" add="tp-serif" separator=" "/>
        </xpath>
    </template>

    <!-- A category with one product repeats its product page: followed, not indexed (and out of the sitemap). -->
    <template id="thin_category_noindex" inherit_id="website.layout" name="Torrepulia: categorie con un solo prodotto">
        <xpath expr="//meta[@t-if='no_index']" position="after">
            <meta t-if="not no_index and main_object and main_object._name == 'product.public.category' and website._torrepulia_thin_category(main_object)"
                  name="robots" content="noindex"/>
        </xpath>
    </template>

</odoo>
