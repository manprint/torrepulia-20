<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="cinematic_pack">
        <div t-if="p.torrepulia_composite and p.torrepulia_unit_count in [2,6]" class="pack-composition" t-att-data-count="p.torrepulia_unit_count" role="img" t-att-aria-label="p.torrepulia_format_detail">
            <div class="pack-unit" t-foreach="range(p.torrepulia_unit_count)" t-as="unit"><img t-att-src="'/web/image/product.template/%s/image_1024' % p.id" alt=""/></div>
        </div>
        <img t-else="" class="format-image" t-att-src="'/web/image/product.template/%s/image_1024' % p.id" t-att-alt="p.name"/>
    </template>
    <template id="cinematic_promoted">
        <a t-if="products and not availability[products[0].id]['blocked']" t-att-href="products[0].website_url" class="button dark early-purchase">
            <span><strong>Acquista <t t-out="products[0].torrepulia_format_name"/></strong><small><t t-out="products[0].torrepulia_format_detail"/> · <t t-out="format_amount(prices[products[0].id]['price_reduce'])"/></small></span>
            <img class="icon" src="/website_torrepulia_theme/static/src/cinematic/icons/arrow-up-right.svg" alt=""/>
        </a>
        <a t-else="" href="/shop" class="button dark">Scopri i formati disponibili</a>
    </template>
    <template id="cinematic_format_stock">
        <t t-set="stock" t-value="availability[p.id]"/>
        <span t-if="stock['show_stock'] and ((stock['remaining'] &lt;= 0 and (stock['has_message'] or not stock['info']['allow_out_of_stock_order'])) or (stock['remaining'] &gt; 0 and stock['info']['show_availability'] and stock['remaining'] &lt;= stock['info']['available_threshold']))" class="mc-format-stock">
            <t t-if="stock['remaining'] &lt;= 0">
                <span t-if="stock['has_message']" t-out="stock['message_text']"/>
                <span t-elif="not stock['info']['allow_out_of_stock_order']">Esaurito</span>
            </t>
            <t t-elif="stock['info']['show_availability'] and stock['remaining'] &lt;= stock['info']['available_threshold']">
                <span>Disponibili: <t t-out="'%g' % stock['remaining']"/><t t-if="stock['info'].get('uom_name')"> <t t-out="stock['info']['uom_name']"/></t></span>
                <span t-if="not stock['info']['allow_out_of_stock_order'] and stock['info']['cart_qty']"> (<t t-out="'%g' % stock['info']['cart_qty']"/> nel carrello)</span>
            </t>
        </span>
    </template>
    <template id="cinematic_formats">
        <div class="shop-layout" t-if="products">
            <div class="shop-stage oe_website_sale">
                <div class="mc-pack-preview" t-foreach="products" t-as="p" t-att-data-preview="p.id" t-att-hidden="p_index != 0">
                    <t t-call="website_torrepulia_theme.cinematic_pack"/>
                    <t t-set="ribbon" t-value="availability[p.id]['ribbon']"/>
                    <t t-if="ribbon" t-call="website_sale.product_ribbon" product="p" text_color="ribbon.text_color" bg_color="ribbon.bg_color"/>
                    <span class="stage-caption">LA REGINA / <t t-out="p.torrepulia_format_detail"/></span>
                </div>
            </div>
            <div class="shop-choice">
                <div class="format-options" role="tablist" aria-label="Formati La Regina" aria-orientation="vertical">
                    <button t-foreach="products" t-as="p" type="button" class="format-option" role="tab" t-att-data-product="p.id" t-att-data-product-url="p.website_url" t-att-aria-selected="'true' if p_index == 0 else 'false'" t-att-tabindex="0 if p_index == 0 else -1">
                        <span class="format-thumb" t-att-data-count="p.torrepulia_unit_count if p.torrepulia_composite else 1" aria-hidden="true"><img t-foreach="range(p.torrepulia_unit_count if p.torrepulia_composite and p.torrepulia_unit_count in [2,6] else 1)" t-as="unit" t-att-src="'/web/image/product.template/%s/image_128' % p.id" alt=""/></span>
                        <span class="mc-format-details"><strong t-out="p.torrepulia_format_name"/><small t-out="p.torrepulia_format_detail"/>
                            <t t-set="ribbon" t-value="availability[p.id]['ribbon']"/>
                            <span t-if="ribbon" class="mc-format-ribbon" t-attf-style="color: #{ribbon.text_color}; background-color: #{ribbon.bg_color};" t-out="ribbon.name"/>
                            <t t-set="format_badges" t-value="p._torrepulia_format_badges(website)"/>
                            <span t-if="format_badges" class="mc-format-badges">
                                <span t-foreach="format_badges" t-as="badge" class="mc-format-badge" t-attf-style="background-color: #{badge['color']}; color: #{badge['text_color']};" t-out="badge['name']"/>
                            </span>
                            <t t-call="website_torrepulia_theme.cinematic_format_stock"/>
                        </span>
                        <span class="option-price"><t t-out="format_amount(prices[p.id]['price_reduce'])"/><img class="icon" src="/website_torrepulia_theme/static/src/cinematic/icons/arrow-up-right.svg" alt=""/></span>
                    </button>
                </div>
                <div class="format-summary" t-foreach="products" t-as="p" t-att-data-summary="p.id" t-att-hidden="p_index != 0" role="tabpanel">
                    <t t-set="stock" t-value="availability[p.id]"/>
                    <p class="format-description" t-out="p.description_sale"/>
                    <div t-if="stock['show_stock'] and stock['remaining'] &lt;= 0 and stock['has_message']" class="mc-format-stock-message" t-field="p.out_of_stock_message"/>
                    <t t-else="" t-call="website_torrepulia_theme.cinematic_format_stock"/>
                    <button t-if="stock['blocked']" type="button" class="button dark format-link" disabled="disabled">Acquista <t t-out="p.torrepulia_format_name"/></button>
                    <a t-else="" class="button dark format-link" t-att-href="p.website_url">Acquista <t t-out="p.torrepulia_format_name"/><img class="icon" src="/website_torrepulia_theme/static/src/cinematic/icons/arrow-up-right.svg" alt=""/></a>
                    <a t-if="stock['blocked']" class="text-link mc-format-details-link" t-att-href="p.website_url">Dettagli del prodotto</a>
                    <p class="small">Spedizione calcolata alla conferma dell'ordine.</p>
                </div>
            </div>
        </div>
        <p t-else="">Nessun formato disponibile. <a href="/contactus">Contattaci</a></p>
    </template>
    <template id="cinematic_product_formats" inherit_id="website_sale.product" name="Cinematic native product formats">
        <xpath expr="//t[@t-call='website_sale.shop_product_images']" position="replace">
            <div t-if="website.torrepulia_theme_enabled and product.torrepulia_composite" class="mc-commerce-composition"><t t-set="p" t-value="product"/><t t-call="website_torrepulia_theme.cinematic_pack"/><p class="small">Contenuto del formato: <span t-field="product.torrepulia_format_detail"/></p></div>
            <t t-else="" t-call="website_sale.shop_product_images"/>
        </xpath>
        <xpath expr="//div[@id='o_wsale_product_cta_section']" position="inside">
            <div class="mc-sticky-summary" t-if="website.torrepulia_theme_enabled and product.torrepulia_format_name"><span t-field="product.torrepulia_format_name"/><t t-call="website_sale.product_price"/></div>
        </xpath>
    </template>
    <template id="product_stock_notification_it" inherit_id="website_sale.cta_wrapper" name="Italian stock notification labels">
        <!-- Odoo 20 ships no Italian translation for these website_sale labels. -->
        <xpath expr="//button[@id='stock_notification_button']" position="replace">
            <button
                id="stock_notification_button"
                t-attf-class="{{'d-none' if combination_info.get('has_stock_notification') else ''}} btn btn-primary flex-grow-1 align-items-center"
                t-att-data-product-id="product.id"
            >
                <i class="oi me-2" data-icon="mail"/>
                Avvisami quando torna disponibile
            </button>
        </xpath>
        <xpath expr="//button[@id='stock_notification_subscribed_button']" position="replace">
            <button
                id="stock_notification_subscribed_button"
                t-attf-class="{{'' if combination_info.get('has_stock_notification') else 'd-none'}} btn btn-outline-primary flex-grow-1 align-items-center"
                disabled=""
            >
                <i class="oi oi-filled me-2" data-icon="notifications"/>
                Ti avviseremo
            </button>
        </xpath>
        <xpath expr="//button[@id='stock_notification_submit_button']" position="replace">
            <button id="stock_notification_submit_button" class="btn btn-primary" t-att-data-product-id="product.id">
                Avvisami
            </button>
        </xpath>
    </template>
    <template id="search_placeholder_it" inherit_id="website.website_search_box_input" name="Italian search placeholder">
        <xpath expr="//t[@t-set='placeholder']" position="replace">
            <t t-if="not placeholder" t-set="placeholder">Cerca…</t>
        </xpath>
    </template>
    <template id="shop_tile_title_level" inherit_id="website_sale.product_title_and_details" name="Shop tile title level">
        <!-- Product names follow the shop H1; the h6 class keeps the native tile size. -->
        <xpath expr="//h6[hasclass('o_wsale_products_item_title')]" position="before">
            <h2 class="o_wsale_products_item_title text-break h6"/>
        </xpath>
        <xpath expr="//h2[hasclass('o_wsale_products_item_title')]" position="inside">
            <xpath expr="//h6[hasclass('o_wsale_products_item_title')]/a" position="move"/>
        </xpath>
        <xpath expr="//h6[hasclass('o_wsale_products_item_title')]" position="replace"/>
    </template>
    <template id="product_breadcrumb_icons" inherit_id="website_sale.product" name="Decorative breadcrumb icons">
        <!-- The chevron repeats the link text; screen readers should not announce an unnamed image. -->
        <xpath expr="//li[hasclass('d-lg-none')]//i[@data-icon='chevron_backward']" position="attributes">
            <attribute name="role"/>
            <attribute name="aria-hidden">true</attribute>
        </xpath>
        <xpath expr="//li[hasclass('d-none')]//i[@data-icon='chevron_backward']" position="attributes">
            <attribute name="role"/>
            <attribute name="aria-hidden">true</attribute>
        </xpath>
    </template>
    <template id="cinematic_shop_pack" inherit_id="website_sale.product_image_and_ribbon" name="Native shop provisional pack composition">
        <xpath expr="//span[hasclass('oe_product_image_img_wrapper_primary')]" position="replace">
            <div t-if="website.torrepulia_theme_enabled and product.torrepulia_composite" class="mc-commerce-composition mc-tile-composition"><t t-set="p" t-value="product"/><t t-call="website_torrepulia_theme.cinematic_pack"/></div>
            <span t-else="" t-field="primary_image_holder.image_1920" t-options="{'widget': 'image', 'preview_image': 'image_1024', 'class': 'oe_product_image_img h-100 w-100'}" class="oe_product_image_img_wrapper oe_product_image_img_wrapper_primary d-flex h-100 justify-content-center align-items-center"/>
        </xpath>
    </template>
    <template id="cinematic_product_title" inherit_id="website_sale.product_title" name="La Regina product heading">
        <xpath expr="//h1" position="replace">
            <t t-if="website.torrepulia_theme_enabled and product.torrepulia_format_name"><h1>La Regina</h1><p class="product-subtitle"><span t-field="product.torrepulia_format_name"/> · <span t-field="product.torrepulia_format_detail"/></p></t>
            <h1 t-else="" class="h3" t-field="product.name"/>
        </xpath>
    </template>
    <record id="cinematic_product_metadata" model="ir.ui.view">
        <field name="name">Torrepulia format configuration</field><field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Torrepulia">
                    <group>
                        <field name="torrepulia_format_name"/>
                        <field name="torrepulia_format_detail"/>
                        <field name="torrepulia_shop_audience"/>
                        <field name="torrepulia_unit_count"/>
                        <field name="torrepulia_composite"/>
                        <field name="torrepulia_format_badge_ids" widget="many2many_tags" options="{'on_tag_click': 'open_form'}"/>
                    </group>
                    <p>Disattivare la composizione provvisoria quando viene caricata la fotografia reale della confezione.</p>
                </page>
            </xpath>
        </field>
    </record>
    <record id="cinematic_badge_tag_form" model="ir.ui.view">
        <field name="name">product.tag.form.torrepulia.badges</field>
        <field name="model">product.tag</field>
        <field name="inherit_id" ref="product.product_tag_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='color']" position="after">
                <field name="website_id" groups="website.group_multi_website"/>
            </xpath>
        </field>
    </record>
</odoo>
