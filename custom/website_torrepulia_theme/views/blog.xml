<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Blog (website_blog): Odoo 20 ships the table of contents labels without an Italian translation. -->
    <template id="blog_toc_label" inherit_id="website_blog.opt_blog_post_toc_display" name="Torrepulia: indice dell'articolo">
        <xpath expr="//div[hasclass('o_wblog_toc')]/h2[1]" position="replace">
            <h2 class="small mb-3">In questa pagina</h2>
        </xpath>
    </template>
    <template id="blog_toc_mobile_label" inherit_id="website_blog.blog_post_content_mobile_toc" name="Torrepulia: indice dell'articolo su telefono">
        <xpath expr="//div[hasclass('o_wblog_toc_mobile')]/h2[1]" position="replace">
            <h2 class="h6">Indice</h2>
        </xpath>
    </template>
    <template id="blog_next_label" inherit_id="website_blog.blog_post_next_compact" name="Torrepulia: articolo consigliato">
        <xpath expr="//a[@t-att-title]" position="attributes">
            <attribute name="t-att-title">'Leggi anche: ' + next_post.name</attribute>
        </xpath>
    </template>
    <template id="blog_next_cover_label" inherit_id="website_blog.blog_post_next_full_cover" name="Torrepulia: articolo successivo">
        <xpath expr="//i[@data-icon='keyboard_arrow_right']" position="attributes">
            <attribute name="aria-label">Leggi anche</attribute>
            <attribute name="title">Leggi anche</attribute>
        </xpath>
    </template>
</odoo>
