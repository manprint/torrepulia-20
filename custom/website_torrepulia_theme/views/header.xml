<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="torrepulia_layout" inherit_id="website.layout" name="Torrepulia Website Scope" active="False">
        <xpath expr="//div[@id='wrapwrap']" position="attributes">
            <attribute name="t-attf-class" add="#{website.torrepulia_theme_enabled and 'tp-site' or ''}" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('o_footer_copyright')]" position="attributes">
            <attribute name="t-if">not website.torrepulia_theme_enabled and not no_copyright</attribute>
        </xpath>
    </template>
    <template id="torrepulia_header_contact" inherit_id="website.header_text_element" name="Torrepulia Header Contact" active="False">
        <xpath expr="//a[starts-with(@href, 'tel:')]" position="attributes">
            <attribute name="href">tel:+393806375074</attribute>
        </xpath>
        <xpath expr="//span[hasclass('o_force_ltr')]" position="replace">
            <span class="o_force_ltr">+39 380 637 5074</span>
        </xpath>
        <xpath expr="//t[contains(@t-elif, 'mail_stretched')]//a" position="attributes">
            <attribute name="href">tel:+393806375074</attribute>
        </xpath>
        <xpath expr="//t[contains(@t-elif, 'mail_stretched')]//span" position="replace">
            <span class="o_force_ltr"><small>+39 380 637 5074</small></span>
        </xpath>
        <xpath expr="//t[@t-else]//a" position="attributes">
            <attribute name="href">tel:+393806375074</attribute>
        </xpath>
        <xpath expr="//t[@t-else]//span" position="replace">
            <span class="o_force_ltr"><small>+39 380 637 5074</small></span>
        </xpath>
        <xpath expr="//a[starts-with(@href, 'mailto:')]" position="replace">
            <a href="mailto:info@torrepulia.it" class="nav-link o_nav-link_secondary"><small><i class="oi me-1" data-icon="mail"/>info@torrepulia.it</small></a>
        </xpath>
        <xpath expr="//t[@t-elif][not(contains(@t-elif, 'phone'))][not(contains(@t-elif, 'stretched'))]//a[starts-with(@href, 'mailto:')]" position="replace">
            <a href="mailto:info@torrepulia.it" class="nav-link o_nav-link_secondary"><small><i class="oi me-1" data-icon="mail"/>info@torrepulia.it</small></a>
        </xpath>
    </template>
</odoo>
