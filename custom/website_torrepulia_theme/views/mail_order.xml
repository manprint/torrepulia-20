<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Order emails, same look as the reservation emails (website_torrepulia_request, mail_request_body):
         tables, inline styles and the theme colors. One body, three moments of the order (`kind`):
         'confirmation' the order confirmation to pay, neutral on the method;
         'payment' a payment started (bank transfer details) or received without confirming the order;
         'confirmed' the order is paid and confirmed, the oil gets ready to leave. -->
    <template id="mail_order_confirmation_body" name="Torrepulia: email dell'ordine">
        <t t-set="serif" t-value="&quot;font-family:'Libre Caslon Display',Georgia,'Times New Roman',serif;font-weight:400;color:#18231f;&quot;"/>
        <t t-set="sans" t-value="&quot;font-family:Manrope,-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;&quot;"/>
        <t t-set="button" t-value="'display:inline-block;padding:14px 32px;background-color:#2e493b;color:#ffffff;font-size:16px;font-weight:600;text-decoration:none;border-radius:3px;'"/>
        <div t-attf-style="margin:0;padding:24px 12px;background-color:#f6f6f4;#{sans}">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                   style="max-width:600px;margin:0 auto;background-color:#ffffff;border:1px solid #d2dcd4;border-collapse:separate;">
                <tr><td align="center" style="padding:32px 40px 8px;">
                    <a t-att-href="base_url" style="text-decoration:none;">
                        <img t-att-src="logo_url" t-att-alt="company['name']" width="120" style="display:block;width:120px;height:auto;border:0;"/>
                    </a>
                </td></tr>
                <tr><td style="padding:24px 40px 0;">
                    <h1 t-attf-style="margin:0 0 12px;font-size:30px;line-height:1.2;#{serif}">
                        <t t-if="kind == 'confirmation'">Ecco la tua conferma d&#8217;ordine<t t-if="first_name">, <t t-out="first_name"/></t>.</t>
                        <t t-elif="kind == 'payment' and transfer">Grazie<t t-if="first_name">, <t t-out="first_name"/></t>. Ora completa il bonifico.</t>
                        <t t-elif="kind == 'payment' and pending">Grazie<t t-if="first_name">, <t t-out="first_name"/></t>. Il pagamento è in elaborazione.</t>
                        <t t-elif="kind == 'payment'">Abbiamo ricevuto il tuo pagamento.</t>
                        <t t-else="">Il tuo ordine è confermato<t t-if="first_name">, <t t-out="first_name"/></t>.</t>
                    </h1>
                    <p style="margin:0;font-size:16px;line-height:1.6;color:#526056;">
                        <t t-if="kind == 'confirmation'">Prezzo bloccato e spese di spedizione incluse.</t>
                        <t t-elif="kind == 'payment' and transfer">Appena il bonifico arriva sul nostro conto confermiamo l&#8217;ordine e prepariamo la spedizione.</t>
                        <t t-elif="kind == 'payment' and pending">Ti scriviamo appena il pagamento è confermato.</t>
                        <t t-elif="kind == 'payment'">Grazie.</t>
                        <t t-else="">Pagamento ricevuto: prepariamo il tuo olio e te lo spediamo direttamente da Torremaggiore.</t>
                        Riferimento <strong style="color:#18231f;" t-out="order.name"/>.
                    </p>
                </td></tr>

                <!-- Bank transfer details: what the customer copies into the bank app. -->
                <tr t-if="kind == 'payment' and transfer"><td style="padding:28px 40px 0;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;background-color:#eef2ed;">
                        <tr t-foreach="transfer" t-as="detail">
                            <td width="120" valign="top" style="padding:14px 12px 0 24px;font-size:13px;line-height:1.5;color:#746014;" t-out="detail[0]"/>
                            <td valign="top" style="padding:12px 24px 0 0;font-size:17px;line-height:1.4;color:#18231f;font-weight:600;word-break:break-all;" t-out="detail[1]"/>
                        </tr>
                        <tr><td colspan="2" style="padding:16px 24px 20px;font-size:14px;line-height:1.6;color:#526056;">
                            <t t-if="deadline">Da completare entro il <strong style="color:#18231f;" t-out="deadline"/>. </t>Scrivi la causale esattamente così: ci serve per riconoscere il tuo bonifico.
                        </td></tr>
                    </table>
                </td></tr>

                <tr><td style="padding:32px 40px 0;">
                    <h2 t-attf-style="margin:0 0 8px;font-size:22px;line-height:1.3;#{serif}">Il tuo olio</h2>
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">
                        <tr t-foreach="rows" t-as="row">
                            <td width="68" valign="top" style="padding:16px 12px 16px 0;border-bottom:1px solid #d2dcd4;">
                                <img t-att-src="row['thumbnail']" alt="" width="56" height="56"
                                     style="display:block;width:56px;height:56px;border:0;background-color:#f6f6f4;object-fit:contain;"/>
                            </td>
                            <td valign="top" style="padding:16px 0;border-bottom:1px solid #d2dcd4;font-size:15px;line-height:1.5;">
                                <strong style="color:#18231f;font-weight:600;" t-out="row['name']"/><br/>
                                <span style="color:#526056;">Quantità <t t-out="row['quantity']"/></span>
                            </td>
                            <td valign="top" align="right" style="padding:16px 0 16px 16px;border-bottom:1px solid #d2dcd4;font-size:15px;line-height:1.5;color:#18231f;white-space:nowrap;"
                                t-out="row['subtotal']"/>
                        </tr>
                        <tr t-if="shipping">
                            <td colspan="2" style="padding:14px 0;border-bottom:1px solid #d2dcd4;font-size:15px;line-height:1.5;color:#18231f;">Spedizione</td>
                            <td align="right" style="padding:14px 0 14px 16px;border-bottom:1px solid #d2dcd4;font-size:15px;line-height:1.5;color:#18231f;white-space:nowrap;" t-out="shipping"/>
                        </tr>
                        <tr>
                            <td colspan="2" style="padding:16px 0 0;font-size:15px;line-height:1.5;color:#18231f;font-weight:600;">Totale <span style="font-weight:400;color:#526056;">IVA inclusa</span></td>
                            <td align="right" style="padding:16px 0 0 16px;font-size:19px;line-height:1.4;color:#18231f;font-weight:600;white-space:nowrap;" t-out="total"/>
                        </tr>
                    </table>
                </td></tr>

                <tr t-if="kind == 'confirmed' and shipping_address"><td style="padding:28px 40px 0;font-size:15px;line-height:1.6;color:#18231f;">
                    <h2 t-attf-style="margin:0 0 8px;font-size:22px;line-height:1.3;#{serif}">Lo spediamo a</h2>
                    <t t-foreach="shipping_address" t-as="address_line"><t t-out="address_line"/><br/></t>
                </td></tr>

                <tr t-if="kind == 'confirmation'"><td style="padding:36px 40px 0;">
                    <p style="margin:0 0 20px;font-size:16px;line-height:1.6;color:#18231f;">
                        <t t-if="deadline">Conferma l&#8217;ordine e completa il pagamento entro il <strong t-out="deadline"/>. </t>Nella pagina trovi il riepilogo completo e scegli come pagare.
                    </p>
                    <a t-att-href="portal_url" t-att-style="button">Conferma e paga</a>
                    <p style="margin:20px 0 0;font-size:15px;line-height:1.6;color:#526056;">
                        Ricevuto il pagamento, ti spediamo l&#8217;olio direttamente da Torremaggiore.
                    </p>
                </td></tr>
                <tr t-else=""><td style="padding:36px 40px 0;">
                    <a t-att-href="portal_url" t-att-style="button">Vedi il tuo ordine</a>
                </td></tr>

                <tr><td style="padding:32px 40px 0;">
                    <p style="margin:0;padding:20px 24px;background-color:#eef2ed;font-size:15px;line-height:1.6;color:#18231f;">
                        <t t-if="kind == 'confirmed'">Hai una domanda sulla spedizione?</t><t t-else="">Vuoi cambiare qualcosa o hai una domanda?</t>
                        Rispondi a questa email<t t-if="company['phone']"> o chiamaci al
                        <a t-attf-href="tel:#{company['phone'].replace(' ', '')}" style="color:#2e493b;font-weight:600;text-decoration:underline;" t-out="company['phone']"/></t>.
                    </p>
                </td></tr>

                <tr><td style="padding:40px 40px 32px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">
                        <tr><td style="padding-top:20px;border-top:1px solid #d2dcd4;font-size:13px;line-height:1.6;color:#526056;">
                            Famiglia Leone, Torremaggiore<br/>
                            <t t-out="company['name']"/><t t-if="company['address']"> · <t t-out="company['address']"/></t><br/>
                            <t t-if="company['vat']">P. IVA <t t-out="company['vat']"/> · </t>
                            <a t-att-href="base_url" style="color:#526056;" t-out="base_url.split('://')[-1]"/>
                        </td></tr>
                    </table>
                </td></tr>
            </table>
        </div>
    </template>

    <!-- Review request, a few days after the oil left (models/reviews.py): same frame as the order
         emails. Every customer is asked, as Google requires; a problem goes to a reply, not a review form. -->
    <template id="mail_order_review_body" name="Torrepulia: richiesta di recensione">
        <t t-set="serif" t-value="&quot;font-family:'Libre Caslon Display',Georgia,'Times New Roman',serif;font-weight:400;color:#18231f;&quot;"/>
        <t t-set="sans" t-value="&quot;font-family:Manrope,-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;&quot;"/>
        <t t-set="button" t-value="'display:inline-block;padding:14px 32px;background-color:#2e493b;color:#ffffff;font-size:16px;font-weight:600;text-decoration:none;border-radius:3px;'"/>
        <div t-attf-style="margin:0;padding:24px 12px;background-color:#f6f6f4;#{sans}">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                   style="max-width:600px;margin:0 auto;background-color:#ffffff;border:1px solid #d2dcd4;border-collapse:separate;">
                <tr><td align="center" style="padding:32px 40px 8px;">
                    <a t-att-href="base_url" style="text-decoration:none;">
                        <img t-att-src="logo_url" t-att-alt="company['name']" width="120" style="display:block;width:120px;height:auto;border:0;"/>
                    </a>
                </td></tr>
                <tr><td style="padding:24px 40px 0;">
                    <h1 t-attf-style="margin:0 0 12px;font-size:30px;line-height:1.2;#{serif}">Com&#8217;è La Regina<t t-if="first_name">, <t t-out="first_name"/></t>?</h1>
                    <p style="margin:0;font-size:16px;line-height:1.6;color:#526056;">
                        Ormai il tuo olio è sulla tua tavola. Ci regali un minuto? Il tuo parere aiuta chi ci sceglie per la prima volta
                        e dice a noi cosa fare meglio la prossima stagione.
                    </p>
                </td></tr>
                <tr t-if="google_url"><td style="padding:32px 40px 0;">
                    <a t-att-href="google_url" t-att-style="button">Lascia una recensione su Google</a>
                </td></tr>
                <tr t-if="reviews_on_site and rows"><td style="padding:32px 40px 0;">
                    <h2 t-attf-style="margin:0 0 8px;font-size:22px;line-height:1.3;#{serif}"><t t-if="google_url">Oppure racconta</t><t t-else="">Racconta</t> il tuo formato sul sito</h2>
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">
                        <tr t-foreach="rows" t-as="row">
                            <td width="68" valign="middle" style="padding:16px 12px 16px 0;border-bottom:1px solid #d2dcd4;">
                                <img t-att-src="row['thumbnail']" alt="" width="56" height="56"
                                     style="display:block;width:56px;height:56px;border:0;background-color:#f6f6f4;object-fit:contain;"/>
                            </td>
                            <td valign="middle" style="padding:16px 0;border-bottom:1px solid #d2dcd4;font-size:15px;line-height:1.5;color:#18231f;font-weight:600;" t-out="row['name']"/>
                            <td valign="middle" align="right" style="padding:16px 0 16px 16px;border-bottom:1px solid #d2dcd4;white-space:nowrap;">
                                <a t-att-href="row['url']" style="color:#2e493b;font-size:15px;font-weight:600;text-decoration:underline;">Valuta</a>
                            </td>
                        </tr>
                    </table>
                </td></tr>
                <tr t-if="not google_url and not (reviews_on_site and rows)"><td style="padding:32px 40px 0;">
                    <a t-att-href="portal_url" t-att-style="button">Vedi il tuo ordine</a>
                </td></tr>
                <tr><td style="padding:32px 40px 0;">
                    <p style="margin:0;padding:20px 24px;background-color:#eef2ed;font-size:15px;line-height:1.6;color:#18231f;">
                        C&#8217;è stato un problema con la consegna o con l&#8217;olio? Rispondi a questa email<t t-if="company['phone']"> o chiamaci al
                        <a t-attf-href="tel:#{company['phone'].replace(' ', '')}" style="color:#2e493b;font-weight:600;text-decoration:underline;" t-out="company['phone']"/></t>: ce ne occupiamo noi.
                    </p>
                </td></tr>
                <tr><td style="padding:40px 40px 32px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">
                        <tr><td style="padding-top:20px;border-top:1px solid #d2dcd4;font-size:13px;line-height:1.6;color:#526056;">
                            Ti scriviamo una sola volta per l&#8217;ordine <t t-out="order.name"/>. Se non vuoi più ricevere richieste come questa, rispondi e scrivicelo.<br/><br/>
                            Famiglia Leone, Torremaggiore<br/>
                            <t t-out="company['name']"/><t t-if="company['address']"> · <t t-out="company['address']"/></t><br/>
                            <t t-if="company['vat']">P. IVA <t t-out="company['vat']"/> · </t>
                            <a t-att-href="base_url" style="color:#526056;" t-out="base_url.split('://')[-1]"/>
                        </td></tr>
                    </table>
                </td></tr>
            </table>
        </div>
    </template>

    <record id="res_config_settings_view_form_reviews" model="ir.ui.view">
        <field name="name">res.config.settings.form.torrepulia.reviews</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='send_order_rating_emails_setting']" position="inside">
                <div invisible="not send_order_rating_emails" class="mt-2">
                    <label string="Link recensioni Google" for="torrepulia_google_review_url" class="o_light_label me-2"/>
                    <field name="torrepulia_google_review_url" placeholder="https://g.page/r/…/review" class="oe_inline" style="min-width: 16rem;"/>
                    <div class="text-muted small mt-1">Sul sito Torrepulia i giorni contano dalla consegna al corriere, non dalla conferma dell'ordine.</div>
                </div>
            </xpath>
        </field>
    </record>

    <!-- The body above is the whole email: no Odoo notification frame around it. -->
    <template id="mail_layout_bare" name="Torrepulia: email senza cornice">
        <t t-out="message.body"/>
    </template>

    <!-- PDF of the confirmation: the title and the dates speak of a confirmation, not of a quote. -->
    <template id="report_order_confirmation" inherit_id="sale.report_saleorder_document" priority="30">
        <xpath expr="//t[@t-set='layout_document_title']/span[@t-elif]" position="replace">
            <span t-elif="doc.state in ['draft','sent'] and doc._torrepulia_website()">Conferma d&#8217;ordine </span>
            <span t-elif="doc.state in ['draft','sent']">Quotation # </span>
        </xpath>
        <xpath expr="//div[@name='informations_date']/strong[@t-elif]" position="replace">
            <strong t-elif="doc.state in ['draft', 'sent'] and doc._torrepulia_website()">Data</strong>
            <strong t-elif="doc.state in ['draft', 'sent']">Quotation Date</strong>
        </xpath>
        <xpath expr="//div[@name='expiration_date']/strong" position="replace">
            <strong t-if="doc._torrepulia_website()">Da confermare entro</strong>
            <strong t-else="">Expiration</strong>
        </xpath>
    </template>
</odoo>
