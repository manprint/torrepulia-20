<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="torrepulia_homepage_view" name="Torrepulia Homepage">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <t t-call="website_torrepulia_theme.s_torrepulia_hero"/>
                <t t-call="website_torrepulia_theme.s_torrepulia_brand_story"/>
                <t t-call="website_torrepulia_theme.s_torrepulia_product_showcase"/>
                <section class="tp-section oe_structure" data-name="Torrepulia Vetrina prodotti">
                    <div class="container">
                        <div class="row mb-4">
                            <div class="col-lg-7">
                                <p class="tp-eyebrow">Shop</p>
                                <h2 class="display-4">Prodotti dal catalogo Torrepulia.</h2>
                            </div>
                        </div>
                    </div>
                    <t t-call="website_sale.s_dynamic_snippet_products_grid"/>
                </section>
                <t t-call="website_torrepulia_theme.s_torrepulia_peranzana"/>
                <t t-call="website_torrepulia_theme.s_torrepulia_terroir"/>
                <t t-call="website_torrepulia_theme.s_torrepulia_editorial"/>
                <t t-call="website_torrepulia_theme.s_torrepulia_production_process"/>
                <t t-call="website_torrepulia_theme.s_torrepulia_product_formats"/>
                <t t-call="website_torrepulia_theme.s_torrepulia_cta"/>
            </div>
        </t>
    </template>

    <record id="torrepulia_homepage" model="website.page">
        <field name="name">Torrepulia</field>
        <field name="url">/torrepulia-home</field>
        <field name="is_published">True</field>
        <field name="website_indexed">True</field>
        <field name="view_id" ref="torrepulia_homepage_view"/>
    </record>
</odoo>
