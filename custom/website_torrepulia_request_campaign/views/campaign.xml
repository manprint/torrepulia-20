<odoo>
    <record id="campaign_list" model="ir.ui.view">
        <field name="name">torrepulia.request.campaign.list</field><field name="model">torrepulia.request.campaign</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="reference"/><field name="website_id"/><field name="state"/><field name="opens_at"/><field name="closes_at"/></list>
        </field>
    </record>
    <record id="campaign_form" model="ir.ui.view">
        <field name="name">torrepulia.request.campaign.form</field><field name="model">torrepulia.request.campaign</field>
        <field name="arch" type="xml">
          <form><sheet>
            <group><group><field name="name"/><field name="reference"/><field name="website_id"/><field name="company_id" invisible="1"/><field name="state"/></group>
                <group><field name="opens_at"/><field name="closes_at"/><field name="delivery_period"/></group></group>
            <field name="introduction" placeholder="Testo editoriale della campagna"/><field name="closed_message"/>
            <group string="Indicazioni commerciali approvate"><field name="shipping_note"/><field name="payment_note"/><field name="price_note"/></group>
            <group string="Shop durante la campagna">
                <field name="shop_state_label" placeholder="Raccolto 2026 · in prenotazione"/>
                <field name="shop_band_title" placeholder="Olio nuovo 2026"/>
                <field name="shop_band_text" placeholder="Prenotazioni aperte. Lo moliamo e lo spediamo entro 48 ore, paghi alla spedizione."/>
            </group>
            <p>I campi vuoti usano il testo indicato, con l'anno di apertura della campagna.</p>
            <p>Seleziona i prodotti filtrati desiderati e trascina le righe per ordinarli. Le varianti sono indipendenti; nessun prodotto viene creato automaticamente.</p>
            <field name="line_ids"><list editable="bottom">
                <field name="sequence" widget="handle"/><field name="company_id" column_invisible="True"/><field name="website_id" column_invisible="True"/>
                <field name="product_id" domain="[('sale_ok', '=', True), '|', ('website_id', '=', False), ('website_id', '=', parent.website_id), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]" options="{'no_create': True}"/>
                <field name="content"/><field name="description"/>
            </list></field>
          </sheet></form>
        </field>
    </record>
    <record id="action_campaigns" model="ir.actions.act_window"><field name="name">Campagne olio nuovo</field><field name="res_model">torrepulia.request.campaign</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_campaigns" name="Campagne olio nuovo" parent="website.menu_site" action="action_campaigns" sequence="65" groups="website.group_website_restricted_editor,sales_team.group_sale_salesman"/>
</odoo>
